<?php /** @var View $this **/ ?>

<div class="table-responsive">
    <table class="table table-curved table-striped">
        <tr>
            <td><?php $this->_('VirtfusionDirectProvisioningMod.traffic_block_info.amount'); ?></td>
            <td><?php echo isset($service_fields->virtfusion_traffic_block_gb)
                ? $this->Html->safe($service_fields->virtfusion_traffic_block_gb . ' GB')
                : null; ?></td>
        </tr>
        <tr>
            <td><?php $this->_('VirtfusionDirectProvisioningMod.traffic_block_info.server_id'); ?></td>
            <td><?php echo isset($service_fields->virtfusion_parent_server_id)
                ? $this->Html->safe($service_fields->virtfusion_parent_server_id)
                : null; ?></td>
        </tr>
        <tr>
            <td><?php $this->_('VirtfusionDirectProvisioningMod.traffic_block_info.period'); ?></td>
            <td><?php echo isset($service_fields->virtfusion_traffic_block_end)
                ? $this->Html->safe($service_fields->virtfusion_traffic_block_end)
                : $this->_('VirtfusionDirectProvisioningMod.traffic_block_info.pending', true); ?></td>
        </tr>
        <?php if (!empty($service_fields->virtfusion_traffic_block_id)) { ?>
        <tr>
            <td><?php $this->_('VirtfusionDirectProvisioningMod.traffic_block_info.block_id'); ?></td>
            <td><?php echo $this->Html->safe($service_fields->virtfusion_traffic_block_id); ?></td>
        </tr>
        <?php } ?>
    </table>
</div>
