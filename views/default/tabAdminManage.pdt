<?php /** @var View $this **/ ?>

<div id="tabAdminManage">
    <?php if (!empty($message)) { ?>
        <div class="alert alert-info">
            <?php echo $this->Html->safe($message); ?>
        </div>
    <?php } ?>
    <?php if (!empty($action_result)) { include __DIR__ . '/action_result.pdt'; } ?>

    <?php $server_unbuilt = isset($server_info) && empty($server_info->built); ?>
    <?php $server_busy = isset($server_info) && !empty($server_info->has_active_tasks); ?>
    <?php if ($server_busy) { ?>
    <div class="alert alert-info">
        <?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.tasks.building', true)); ?>
    </div>
    <div class="mb-3">
        <a href="<?php echo $this->Html->safe($admin_server_url); ?>" target="_blank" rel="noopener" class="btn btn-primary w-100">
            <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.manage_admin'); ?>
        </a>
    </div>
    <?php } elseif ($server_unbuilt) { ?>
    <div class="mb-3">
        <a href="<?php echo $this->Html->safe($admin_server_url); ?>" target="_blank" rel="noopener" class="btn btn-primary w-100">
            <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.manage_admin'); ?>
        </a>
    </div>
    <?php } else { ?>

    <?php if (!empty($server_info->has_pending_tasks)) { ?>
        <div class="alert alert-warning">
            <div><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.tasks.pending_restart', true)); ?></div>
            <ul class="mb-0 mt-2">
                <?php foreach ($server_info->pending_tasks as $pending_task) { ?>
                    <li><?php echo $this->Html->safe($pending_task); ?></li>
                <?php } ?>
            </ul>
        </div>
    <?php } ?>
    <?php if (($service_fields->virtfusion_build_state ?? '') === 'failed_or_unknown') { ?>
        <div class="alert alert-warning">
            <?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.build_reconciliation_required', true)); ?>
        </div>
    <?php } ?>

    <?php if (isset($server_info)) { ?>
        <div class="row">
            <div class="col-md-6 service-info">
                <label>Name</label>
                <h4><?php echo $this->Html->safe($server_info->name ?? 'None'); ?></h4>
                <label>CPU</label>
                <h4><?php echo $this->Html->safe($server_info->cpu ?? 'None'); ?></h4>
                <label><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.service_info.package', true)); ?></label>
                <h4><?php echo $this->Html->safe($package->name ?? 'None'); ?></h4>
                <label>RAM</label>
                <h4><?php echo $this->Html->safe($server_info->memory ?? 'None'); ?> MB</h4>
                <label>Disk</label>
                <h4><?php echo $this->Html->safe($server_info->disk ?? 'None'); ?> GB</h4>
            </div>
            <div class="col-md-6 service-info">
                <label><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.service_info.traffic_total', true)); ?></label>
                <h4><?php echo $this->Html->safe($server_info->traffic_total ?? 'None'); ?> GB</h4>
                <label><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.service_info.traffic_server', true)); ?></label>
                <h4><?php echo $this->Html->safe($server_info->traffic_server ?? 'None'); ?> GB</h4>
                <label><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.service_info.traffic_resets', true)); ?></label>
                <h4><?php echo !empty($server_info->traffic_reset)
                    ? $this->Html->safe($this->Date->cast($server_info->traffic_reset, 'date'))
                    : 'None'; ?></h4>
                <label><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.service_info.traffic_used', true)); ?></label>
                <h4><?php echo $this->Html->safe($server_info->traffic_used ?? 'None'); ?> GB</h4>
                <?php if (isset($server_info->traffic_percent)) { ?>
                    <div class="progress mb-3"><div class="progress-bar" style="width: <?php echo (float) $server_info->traffic_percent; ?>%">
                        <?php echo $this->Html->safe($server_info->traffic_percent); ?>%
                    </div></div>
                <?php } ?>
                <label><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.service_info.traffic_blocks', true)); ?></label>
                <h4><?php echo $this->Html->safe($server_info->traffic_blocks ?? 0); ?> GB</h4>
                <label>Status</label>
                <h4><?php echo $this->Html->safe($server_info->status ?? 'None'); ?></h4>
                <label>IPv4</label>
                <h4><?php echo $this->Html->safe($server_info->ipv4 ?? 'None'); ?></h4>
                <label>IPv6</label>
                <h4><?php echo $this->Html->safe($server_info->ipv6 ?? 'None'); ?></h4>
                <label><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.service_info.port_speed_inbound', true)); ?></label>
                <h4><?php echo $this->Html->safe($server_info->network_in ?? 'None'); ?></h4>
                <label><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.service_info.port_speed_outbound', true)); ?></label>
                <h4><?php echo $this->Html->safe($server_info->network_out ?? 'None'); ?></h4>
                <label><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.service_info.backups', true)); ?></label>
                <h4><?php echo $this->Html->safe($server_info->backup_count ?? 0); ?> — <?php echo !empty($server_info->latest_backup->created)
                    ? $this->Html->safe($this->Date->cast($server_info->latest_backup->created, 'date_time'))
                    : 'None'; ?></h4>
                <label><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.service_info.backup_plan', true)); ?></label>
                <h4><?php echo $this->Html->safe($server_info->backup_plan ?? 'None'); ?></h4>
            </div>
        </div>
        <hr>
    <?php } ?>

    <?php if (isset($ip_data)) { ?>
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong><?php $this->_('VirtfusionDirectProvisioningMod.ipAddresses.header'); ?></strong>
            <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                <button type="submit" name="action" value="refresh_ips" class="btn btn-sm btn-outline-secondary">
                    <?php $this->_('VirtfusionDirectProvisioningMod.ipAddresses.refresh'); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
        <div class="card-body"><div class="row">
            <?php foreach (['main', 'base', 'extra', 'ipv6'] as $ip_type) { ?>
            <div class="col-md-6 mb-3">
                <h6><?php $this->_('VirtfusionDirectProvisioningMod.ipAddresses.' . $ip_type); ?></h6>
                <?php $addresses = $ip_data->ip_addresses[$ip_type] ?? []; ?>
                <?php if (empty($addresses)) { ?>
                    <span class="text-muted"><?php $this->_('VirtfusionDirectProvisioningMod.ipAddresses.none'); ?></span>
                <?php } else { ?>
                    <ul class="list-group list-group-flush">
                    <?php foreach ($addresses as $address) { ?>
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <code><?php echo $this->Html->safe($address); ?></code>
                            <?php if ($ip_type === 'extra' && !empty($ip_data->editable_options['extra'])) { ?>
                                <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                                    <?php $this->Form->fieldHidden('ip_address', $address); ?>
                                    <button type="submit" name="action" value="remove_ip" class="btn btn-sm btn-outline-danger" onclick="return confirm(<?php echo $this->Html->safe(json_encode($this->_('VirtfusionDirectProvisioningMod.ipAddresses.remove_confirm', true))); ?>);">
                                        <?php $this->_('VirtfusionDirectProvisioningMod.ipAddresses.remove'); ?>
                                    </button>
                                <?php $this->Form->end(); ?>
                            <?php } ?>
                        </li>
                    <?php } ?>
                    </ul>
                <?php } ?>
            </div>
            <?php } ?>
        </div></div>
    </div>
    <?php } ?>

    <?php
    $server_available = isset($server_info);
    $tasks_locked = $server_available && !empty($server_info->tasks_active);
    $running = $server_available && isset($server_info->power) ? (bool) $server_info->power : null;
    $power_locked = !$server_available || !empty($server_info->has_active_tasks) || $running === null;
    $confirm_power = Language::_('VirtfusionDirectProvisioningMod.confirm.power', true);
    $confirm_password = Language::_('VirtfusionDirectProvisioningMod.confirm.reset_password', true);
    ?>
    <div class="row g-2 mb-3">
        <div class="col-md-6">
            <a href="<?php echo $this->Html->safe($admin_server_url); ?>" target="_blank" rel="noopener" class="btn btn-primary w-100">
                <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.manage_admin'); ?>
            </a>
        </div>
        <div class="col-md-6">
            <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                <button type="submit" name="action" value="vnc" class="btn btn-outline-primary w-100" <?php echo $tasks_locked ? 'disabled' : ''; ?>>
                    <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.vnc_console'); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center gap-3">
            <strong><?php $this->_('VirtfusionDirectProvisioningMod.tabManage.actions'); ?></strong>
            <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                <button type="submit" name="action" value="refresh_state" class="btn btn-sm btn-outline-secondary">
                    <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.refresh_state'); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
        <div class="card-body">
            <div class="row g-2">
                <?php if ($running === false) { ?>
                <div class="col-sm-6 col-lg-3">
                    <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                        <button type="submit" name="action" value="boot" class="btn btn-outline-secondary w-100" <?php echo $power_locked ? 'disabled' : ''; ?>>
                            <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.boot'); ?>
                        </button>
                    <?php $this->Form->end(); ?>
                </div>
                <?php } elseif ($running === true) { ?>
                <?php foreach (['restart', 'shutdown', 'poweroff'] as $power_action) { ?>
                <div class="col-sm-6 col-lg-3">
                    <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                        <button type="submit" name="action" value="<?php echo $power_action; ?>" class="btn <?php echo $power_action === 'poweroff' ? 'btn-outline-danger' : 'btn-outline-secondary'; ?> w-100" onclick="return confirm(<?php echo $this->Html->safe(json_encode($confirm_power)); ?>);" <?php echo $power_locked ? 'disabled' : ''; ?>>
                            <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.' . $power_action); ?>
                        </button>
                    <?php $this->Form->end(); ?>
                </div>
                <?php } ?>
                <?php } ?>
                <div class="col-sm-6 col-lg-3">
                    <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                        <button type="submit" name="action" value="resetpass" class="btn btn-outline-secondary w-100" onclick="return confirm(<?php echo $this->Html->safe(json_encode($confirm_password)); ?>);" <?php echo $tasks_locked ? 'disabled' : ''; ?>>
                            <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.reset_password'); ?>
                        </button>
                    <?php $this->Form->end(); ?>
                </div>
            </div>
        </div>
    </div>
    <?php } ?>
</div>
