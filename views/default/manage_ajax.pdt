<style>
#tabManage, #tabAdminManage { position: relative; isolation: isolate; min-height: 12rem; }
.vf-manage-overlay { position: absolute; inset: 0; z-index: 1040; display: flex; align-items: flex-start; justify-content: center; padding: clamp(1rem, 8vh, 4rem) 1rem 1rem; background: rgba(248, 249, 250, 0.9); backdrop-filter: blur(1px); }
.vf-manage-overlay[hidden] { display: none !important; }
.vf-manage-overlay-panel { position: sticky; top: 1rem; width: min(100%, 38rem); max-height: calc(100vh - 2rem); max-height: calc(100dvh - 2rem); overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.25rem; background: #fff; box-shadow: 0 0.75rem 2rem rgba(33, 37, 41, 0.16); }
.vf-manage-overlay-panel.alert-info { border-color: #9ec5fe; }
.vf-manage-overlay-panel.alert-success { border-color: #a3cfbb; }
.vf-manage-overlay-panel.alert-warning { border-color: #ffe69c; }
.vf-manage-overlay-panel.alert-danger { border-color: #f1aeb5; }
.vf-working-status { display: flex; align-items: center; gap: 0.85rem; }
.vf-working-spinner { flex: 0 0 auto; width: 1.5rem; height: 1.5rem; border: 0.2rem solid #cbd5e1; border-top-color: #0d6efd; border-radius: 50%; animation: vf-working-spin 0.8s linear infinite; }
.vf-working-progress { height: 0.4rem; overflow: hidden; background: #d9e2ec; border-radius: 0.25rem; }
.vf-working-progress-bar { width: 38%; height: 100%; background: #0d6efd; animation: vf-working-scroll 1.15s ease-in-out infinite; }
@keyframes vf-working-spin { to { transform: rotate(360deg); } }
@keyframes vf-working-scroll { from { transform: translateX(-110%); } to { transform: translateX(370%); } }
@media (max-width: 575.98px) {
    .vf-manage-overlay { padding: 0.75rem; }
    .vf-manage-overlay-panel { top: 0.75rem; max-height: calc(100vh - 1.5rem); max-height: calc(100dvh - 1.5rem); }
}
</style>
<script type="text/javascript">
(function () {
    if (!window.fetch || !window.FormData) {
        return;
    }

    function runScripts(container) {
        container.querySelectorAll('script').forEach(function (oldScript) {
            var script = document.createElement('script');
            Array.prototype.forEach.call(oldScript.attributes, function (attribute) {
                script.setAttribute(attribute.name, attribute.value);
            });
            script.textContent = oldScript.textContent;
            oldScript.replaceWith(script);
        });
    }

    function currentRoot(id) {
        return document.getElementById(id);
    }

    function requestJson(url, options) {
        return window.fetch(url, options).then(function (response) {
            if (!response.ok) {
                throw new Error('VirtFusion Manage request failed.');
            }
            return response.json();
        });
    }

    function stateRequestUrl(current) {
        var url = new URL(current.getAttribute('data-vf-refresh-url') || window.location.href, window.location.href);
        url.searchParams.set('vf_response', 'state');
        return url.toString();
    }

    function setText(current, selector, value) {
        var element = current.querySelector(selector);
        if (element) {
            element.textContent = value == null ? '' : String(value);
        }
    }

    function updateMeter(current, name, meter) {
        setText(current, '[data-vf-resource-value="' + name + '"]', meter.value);
        var slot = current.querySelector('[data-resource-meter="' + name + '"]');
        if (!slot) {
            return;
        }
        var usage = Number(meter.usage);
        var available = meter.usage !== null && meter.usage !== '' && Number.isFinite(usage);
        var row = slot.querySelector('[data-vf-resource-usage-row]');
        var progress = slot.querySelector('[data-vf-resource-progress]');
        var bar = slot.querySelector('[data-vf-resource-progress-bar]');
        if (row) {
            row.hidden = !available;
        }
        if (progress) {
            progress.hidden = !available;
            progress.setAttribute('aria-valuenow', available ? String(usage) : '0');
        }
        if (bar) {
            bar.style.width = (available ? Math.min(100, Math.max(0, usage)) : 0) + '%';
        }
        var label = slot.querySelector('[data-vf-resource-usage]');
        if (label) {
            label.textContent = available ? usage + '%' : '';
        }
    }

    function updateAddressList(current, family, addresses) {
        var list = current.querySelector('[data-vf-network-list="' + family + '"]');
        var empty = current.querySelector('[data-vf-network-empty="' + family + '"]');
        if (!list) {
            return;
        }
        list.replaceChildren();
        (Array.isArray(addresses) ? addresses : []).forEach(function (address) {
            var item = document.createElement('li');
            var code = document.createElement('code');
            item.className = 'mb-2';
            code.className = 'text-break';
            code.textContent = String(address);
            item.appendChild(code);
            list.appendChild(item);
        });
        list.hidden = list.children.length === 0;
        if (empty) {
            empty.hidden = list.children.length > 0;
        }
    }

    function updateState(current, state) {
        current.setAttribute('data-vf-busy', state.busy ? 'true' : 'false');
        current.setAttribute('data-vf-built', state.built ? 'true' : 'false');
        current.setAttribute('data-vf-refresh-seconds', String(state.refreshSeconds || 60));
        setText(current, '[data-vf-state-name]', state.name);
        setText(current, '[data-vf-state-status]', state.status);

        var badge = current.querySelector('[data-vf-state-status]');
        if (badge) {
            badge.classList.toggle('bg-success', state.running === true);
            badge.classList.toggle('badge-success', state.running === true);
            badge.classList.toggle('bg-secondary', state.running !== true);
            badge.classList.toggle('badge-secondary', state.running !== true);
        }
        var refreshButton = current.querySelector('[data-vf-state-refresh]');
        if (refreshButton) {
            refreshButton.disabled = !!state.busy;
        }

        Object.keys(state.resources || {}).forEach(function (name) {
            updateMeter(current, name, state.resources[name]);
        });
        Object.keys(state.traffic || {}).forEach(function (name) {
            setText(current, '[data-vf-traffic="' + name + '"]', state.traffic[name]);
        });
        var trafficPercent = Number(state.traffic && state.traffic.percent);
        var trafficAvailable = state.traffic && state.traffic.percent !== null
            && state.traffic.percent !== '' && Number.isFinite(trafficPercent);
        var trafficProgress = current.querySelector('[data-vf-traffic-progress]');
        var trafficBar = current.querySelector('[data-vf-traffic-progress-bar]');
        if (trafficProgress) {
            trafficProgress.hidden = !trafficAvailable;
        }
        if (trafficBar) {
            trafficBar.style.width = (trafficAvailable ? Math.min(100, Math.max(0, trafficPercent)) : 0) + '%';
            trafficBar.setAttribute('aria-valuenow', trafficAvailable ? String(trafficPercent) : '0');
        }

        updateAddressList(current, 'ipv4', state.network && state.network.ipv4);
        updateAddressList(current, 'ipv6', state.network && state.network.ipv6);
        setText(current, '[data-vf-network-speed="in"]', state.network && state.network.in);
        setText(current, '[data-vf-network-speed="out"]', state.network && state.network.out);
        var ipv6Action = current.querySelector('[data-vf-ipv6-choice-open]');
        var ipv6Note = current.querySelector('[data-vf-ipv6-available-note]');
        var ipv6Empty = current.querySelector('[data-vf-network-empty="ipv6"]');
        var showIpv6Action = !!(state.network && state.network.ipv6Available && !state.network.ipv6Enabled);
        if (ipv6Action) {
            ipv6Action.hidden = !showIpv6Action;
            ipv6Action.disabled = !!state.tasksLocked
                || ipv6Action.getAttribute('data-vf-template-available') !== 'true';
        }
        if (ipv6Note) {
            ipv6Note.hidden = !showIpv6Action;
        }
        if (ipv6Empty && state.network && state.network.ipv6Available) {
            ipv6Empty.hidden = true;
        }

        var taskStatus = current.querySelector('[data-vf-task-status]');
        if (taskStatus) {
            taskStatus.hidden = !!current.querySelector('[data-vf-action-overlay]') || !state.busy;
        }
        var pending = Array.isArray(state.pendingTasks) ? state.pendingTasks : [];
        var pendingNotice = current.querySelector('[data-vf-pending-tasks]');
        var pendingList = current.querySelector('[data-vf-pending-task-list]');
        if (pendingList) {
            pendingList.replaceChildren();
            pending.forEach(function (description) {
                var item = document.createElement('li');
                item.textContent = String(description);
                pendingList.appendChild(item);
            });
        }
        if (pendingNotice) {
            pendingNotice.hidden = !state.built || pending.length === 0;
        }

        current.querySelectorAll('[data-vf-power-visible]').forEach(function (item) {
            item.hidden = state.running === null
                || item.getAttribute('data-vf-power-visible') !== (state.running ? 'running' : 'stopped');
            var button = item.querySelector('button[name="action"]');
            if (button) {
                button.disabled = !!state.busy || state.running === null;
            }
        });
        current.querySelectorAll('[data-vf-task-lockable]').forEach(function (button) {
            button.disabled = !!state.tasksLocked;
        });
        syncBuildProgress(current);
    }

    function responseRoot(current, data) {
        var holder = document.createElement('div');
        holder.innerHTML = data.content || '';
        var incoming = holder.querySelector('#' + current.id);
        if (!incoming) {
            throw new Error('VirtFusion Manage response did not include tab content.');
        }
        return incoming;
    }

    function patchSection(current, incoming, name) {
        var selector = '[data-vf-refresh-section="' + name + '"]';
        var liveSection = current.querySelector(selector);
        var incomingSection = incoming.querySelector(selector);
        if (!liveSection || !incomingSection) {
            return;
        }
        var replacement = incomingSection.cloneNode(true);
        liveSection.replaceWith(replacement);
        runScripts(replacement);
    }

    function syncBuildProgress(current) {
        var progress = current.querySelector('[data-vf-build-progress]');
        var taskStatus = current.querySelector('[data-vf-task-status]');
        if (taskStatus) {
            taskStatus.hidden = !!current.querySelector('[data-vf-action-overlay]')
                || current.getAttribute('data-vf-busy') !== 'true';
        }
        if (!progress || current.getAttribute('data-vf-busy') === 'true'
            || progress.getAttribute('data-vf-complete') === 'true') {
            return;
        }

        progress.setAttribute('data-vf-complete', 'true');
        progress.setAttribute('aria-busy', 'false');
        var surface = progress.querySelector('[data-vf-build-surface]') || progress;
        surface.setAttribute('aria-busy', 'false');
        surface.classList.remove('alert-info', 'border-info');
        surface.classList.add('alert-success', 'border-success');
        progress.querySelectorAll('[data-vf-build-active]').forEach(function (element) {
            element.hidden = true;
        });
        var title = progress.querySelector('[data-vf-build-title]');
        var message = progress.querySelector('[data-vf-build-message]');
        var refresh = progress.querySelector('[data-vf-build-refresh]');
        if (title) {
            title.textContent = progress.getAttribute('data-vf-complete-title') || '';
        }
        if (message) {
            message.textContent = progress.getAttribute('data-vf-complete-hint') || '';
        }
        if (refresh) {
            refresh.hidden = false;
        }
    }

    function updateResponseMessage(current, data, isPolling) {
        if (isPolling) {
            return;
        }
        var host = current.querySelector('[data-vf-response-host]');
        if (!host) {
            return;
        }
        host.replaceChildren();
        if (!data.message || String(data.message).trim() === '') {
            return;
        }
        var message = document.createElement('div');
        message.className = 'virtfusion-module-response-message mb-3';
        message.innerHTML = data.message;
        host.appendChild(message);
    }

    function updateActionResponse(current, data) {
        var wasBuilt = current.getAttribute('data-vf-built') === 'true';
        var host = current.querySelector('[data-vf-response-host]');
        if (host) {
            host.replaceChildren();
            if (data.ok === false) {
                var alert = document.createElement('div');
                alert.className = 'alert alert-danger mb-4';
                alert.setAttribute('role', 'alert');
                var errors = Array.isArray(data.errors) ? data.errors : [];
                if (errors.length <= 1) {
                    alert.textContent = errors[0] || 'The VirtFusion action was unsuccessful.';
                } else {
                    var list = document.createElement('ul');
                    list.className = 'mb-0';
                    errors.forEach(function (error) {
                        var item = document.createElement('li');
                        item.textContent = String(error);
                        list.appendChild(item);
                    });
                    alert.appendChild(list);
                }
                host.appendChild(alert);
            } else if (data.feedback) {
                var template = document.createElement('template');
                template.innerHTML = String(data.feedback);
                host.appendChild(template.content.cloneNode(true));
                runScripts(host);
            }
        }
        if (data.state && data.state.available !== false) {
            updateState(current, data.state);
            if (wasBuilt !== !!data.state.built) {
                return refreshHtml(current, true).catch(function () {
                    return current;
                });
            }
        }
        return Promise.resolve(current);
    }

    function updateManage(current, data, isPolling) {
        var incoming = responseRoot(current, data);
        ['data-vf-busy', 'data-vf-built', 'data-vf-refresh-seconds', 'data-vf-refresh-url'].forEach(function (attribute) {
            if (incoming.hasAttribute(attribute)) {
                current.setAttribute(attribute, incoming.getAttribute(attribute));
            }
        });

        if (!isPolling) {
            patchSection(current, incoming, 'feedback');
        }
        var hasBuildProgress = !!current.querySelector('[data-vf-build-progress]');
        if (!hasBuildProgress) {
            patchSection(current, incoming, 'task');
        }
        ['notices', 'overview', 'network', 'operating-system', 'more-features'].forEach(function (name) {
            patchSection(current, incoming, name);
        });
        updateResponseMessage(current, data, isPolling);
        syncBuildProgress(current);
        return current;
    }

    function isUserBusy(current) {
        var focused = document.activeElement;
        return document.hidden
            || current.querySelector('.modal.show:not([data-vf-passive-modal])')
            || current.querySelector('[data-vf-os-installer][data-vf-dirty="true"]')
            || (focused && current.contains(focused) && /^(INPUT|SELECT|TEXTAREA)$/.test(focused.tagName));
    }

    function refreshHtml(current, isPolling) {
        return requestJson(current.getAttribute('data-vf-refresh-url') || window.location.href, {
            method: 'GET',
            credentials: 'same-origin',
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        }).then(function (data) {
            return updateManage(current, data, isPolling);
        });
    }

    function refreshState(current) {
        var wasBuilt = current.getAttribute('data-vf-built') === 'true';
        return requestJson(stateRequestUrl(current), {
            method: 'GET',
            credentials: 'same-origin',
            cache: 'no-store',
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        }).then(function (data) {
            if (!data || !data.state || data.state.available === false) {
                throw new Error('VirtFusion state is unavailable.');
            }
            updateState(current, data.state);
            if (wasBuilt !== !!data.state.built) {
                return refreshHtml(current, true);
            }
            return current;
        });
    }

    function schedule(current) {
        window.clearTimeout(window.virtfusionManageRefreshTimer);
        if (!current || !current.isConnected) {
            return;
        }
        var seconds = Number(current.getAttribute('data-vf-refresh-seconds')) || 60;
        var delay = seconds === 5
            ? 5000 - (Date.now() % 5000)
            : seconds * 1000;
        window.virtfusionManageRefreshTimer = window.setTimeout(function () {
            var liveCurrent = currentRoot(current.id);
            if (!liveCurrent) {
                return;
            }
            if (isUserBusy(liveCurrent)) {
                schedule(liveCurrent);
                return;
            }
            refreshState(liveCurrent).then(function (updatedCurrent) {
                schedule(updatedCurrent || liveCurrent);
            }).catch(function () {
                schedule(liveCurrent);
            });
        }, delay);
    }

    function releaseSubmittedModal(form, current) {
        var modal = form.closest('.modal') || current.querySelector('.modal.show');
        var backdrops = document.querySelectorAll('.modal-backdrop');
        if (!modal && backdrops.length === 0) {
            return;
        }
        if (modal) {
            modal.classList.remove('show');
            modal.style.display = 'none';
            modal.setAttribute('aria-hidden', 'true');
            modal.removeAttribute('aria-modal');
        }
        backdrops.forEach(function (backdrop) {
            backdrop.remove();
        });
        document.body.classList.remove('modal-open');
        document.body.style.removeProperty('padding-right');
    }

    var workingLabels = {
        resetpass: <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.action_working.reset_password', true)); ?>,
        build: <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.action_working.install', true)); ?>,
        rebuild: <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.action_working.reinstall', true)); ?>
    };

    function showWorkingOverlay(action, current) {
        if (!workingLabels[action] || !current) {
            return null;
        }
        var modal = document.createElement('div');
        modal.className = 'vf-manage-overlay vf-working-modal';
        modal.setAttribute('role', 'status');
        modal.setAttribute('aria-live', 'polite');
        modal.setAttribute('aria-busy', 'true');
        modal.setAttribute('data-vf-manage-overlay', '');
        modal.setAttribute('data-vf-action-overlay', '');
        modal.innerHTML = '<div class="vf-manage-overlay-panel alert-info border-info"><div class="modal-body p-4">'
            + '<div class="vf-working-status mb-3"><span class="vf-working-spinner" aria-hidden="true"></span>'
            + '<div><h5 class="mb-1" data-vf-working-title></h5><div class="small text-muted" data-vf-working-message></div></div></div>'
            + '<div class="vf-working-progress" aria-hidden="true"><div class="vf-working-progress-bar"></div></div>'
            + '</div></div>';
        modal.querySelector('[data-vf-working-title]').textContent = workingLabels[action];
        modal.querySelector('[data-vf-working-message]').textContent = <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.action_working.wait', true)); ?>;
        var taskStatus = current.querySelector('[data-vf-task-status]');
        if (taskStatus) {
            taskStatus.hidden = true;
        }
        current.appendChild(modal);
        return modal;
    }

    function removeWorkingOverlay(overlay) {
        if (!overlay) {
            return;
        }
        var current = overlay.closest('#tabManage, #tabAdminManage');
        overlay.remove();
        var taskStatus = current && current.querySelector('[data-vf-task-status]');
        if (taskStatus) {
            taskStatus.hidden = current.getAttribute('data-vf-busy') !== 'true'
                || !!current.querySelector('[data-vf-action-overlay]');
        }
    }

    if (!window.virtfusionManageAjaxBound) {
        window.virtfusionManageAjaxBound = true;
        document.addEventListener('submit', function (event) {
            var form = event.target;
            if (event.defaultPrevented || !form || !form.closest || form.target === '_blank') {
                return;
            }
            var current = form.closest('#tabManage, #tabAdminManage');
            if (!current) {
                return;
            }

            event.preventDefault();
            window.clearTimeout(window.virtfusionManageRefreshTimer);
            var submitter = event.submitter || document.activeElement;
            var formData = new FormData(form);
            if (submitter && submitter.name && !formData.has(submitter.name)) {
                formData.append(submitter.name, submitter.value);
            }
            formData.set('vf_response', 'action');
            if (submitter) {
                submitter.disabled = true;
            }
            var action = submitter && submitter.value ? String(submitter.value) : '';
            var workingOverlay = null;
            if (workingLabels[action]) {
                releaseSubmittedModal(form, current);
                workingOverlay = showWorkingOverlay(action, current);
            }

            requestJson(form.getAttribute('action') || window.location.href, {
                method: 'POST',
                body: formData,
                credentials: 'same-origin',
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            }).then(function (data) {
                removeWorkingOverlay(workingOverlay);
                releaseSubmittedModal(form, current);
                if (data && data.responseType === 'action') {
                    return updateActionResponse(current, data);
                }
                return Promise.resolve(updateManage(current, data, false));
            }).then(function (updatedCurrent) {
                schedule(updatedCurrent || current);
            }).catch(function () {
                removeWorkingOverlay(workingOverlay);
                releaseSubmittedModal(form, current);
                updateActionResponse(current, {
                    ok: false,
                    errors: [<?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.action_working.unconfirmed', true)); ?>]
                });
                if (submitter) {
                    submitter.disabled = false;
                }
                schedule(current);
            });
        });

        document.addEventListener('click', function (event) {
            var refreshButton = event.target.closest && event.target.closest('[data-vf-build-refresh]');
            if (!refreshButton) {
                return;
            }
            var current = refreshButton.closest('#tabManage, #tabAdminManage');
            if (!current) {
                return;
            }
            event.preventDefault();
            refreshButton.disabled = true;
            window.clearTimeout(window.virtfusionManageRefreshTimer);
            refreshState(current).then(function () {
                var progress = current.querySelector('[data-vf-build-progress]');
                if (progress) {
                    if (window.virtfusionResultModal) {
                        window.virtfusionResultModal.remove(progress);
                    } else {
                        progress.remove();
                    }
                }
                schedule(current);
            }).catch(function () {
                refreshButton.disabled = false;
                schedule(current);
            });
        });
    }

    var initial = document.querySelector('#tabManage, #tabAdminManage');
    syncBuildProgress(initial);
    schedule(initial);
}());
</script>
