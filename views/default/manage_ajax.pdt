<script type="text/javascript">
(function () {
    if (!window.fetch || !window.FormData) {
        return;
    }

    function runScripts(container) {
        container.querySelectorAll('script').forEach(function (oldScript) {
            var script = document.createElement('script');
            Array.prototype.forEach.call(oldScript.attributes, function (attribute) {
                script.setAttribute(attribute.name, attribute.value);
            });
            script.textContent = oldScript.textContent;
            oldScript.replaceWith(script);
        });
    }

    function currentRoot(id) {
        return document.getElementById(id);
    }

    function requestJson(url, options) {
        return window.fetch(url, options).then(function (response) {
            if (!response.ok) {
                throw new Error('VirtFusion Manage request failed.');
            }
            return response.json();
        });
    }

    function responseRoot(current, data) {
        var holder = document.createElement('div');
        holder.innerHTML = data.content || '';
        var incoming = holder.querySelector('#' + current.id);
        if (!incoming) {
            throw new Error('VirtFusion Manage response did not include tab content.');
        }
        return incoming;
    }

    function patchSection(current, incoming, name) {
        var selector = '[data-vf-refresh-section="' + name + '"]';
        var liveSection = current.querySelector(selector);
        var incomingSection = incoming.querySelector(selector);
        if (!liveSection || !incomingSection) {
            return;
        }
        var replacement = incomingSection.cloneNode(true);
        liveSection.replaceWith(replacement);
        runScripts(replacement);
    }

    function syncBuildProgress(current) {
        var progress = current.querySelector('[data-vf-build-progress]');
        var taskStatus = current.querySelector('[data-vf-task-status]');
        if (taskStatus) {
            taskStatus.hidden = !!progress;
        }
        if (!progress || current.getAttribute('data-vf-busy') === 'true'
            || progress.getAttribute('data-vf-complete') === 'true') {
            return;
        }

        progress.setAttribute('data-vf-complete', 'true');
        progress.setAttribute('aria-busy', 'false');
        progress.classList.remove('alert-info', 'border-info');
        progress.classList.add('alert-success', 'border-success');
        progress.querySelectorAll('[data-vf-build-active]').forEach(function (element) {
            element.hidden = true;
        });
        var title = progress.querySelector('[data-vf-build-title]');
        var message = progress.querySelector('[data-vf-build-message]');
        var refresh = progress.querySelector('[data-vf-build-refresh]');
        if (title) {
            title.textContent = progress.getAttribute('data-vf-complete-title') || '';
        }
        if (message) {
            message.textContent = progress.getAttribute('data-vf-complete-hint') || '';
        }
        if (refresh) {
            refresh.hidden = false;
        }
    }

    function updateResponseMessage(current, data, isPolling) {
        if (isPolling) {
            return;
        }
        var host = current.querySelector('[data-vf-response-host]');
        if (!host) {
            return;
        }
        host.replaceChildren();
        if (!data.message || String(data.message).trim() === '') {
            return;
        }
        var message = document.createElement('div');
        message.className = 'virtfusion-module-response-message mb-3';
        message.innerHTML = data.message;
        host.appendChild(message);
    }

    function updateManage(current, data, isPolling) {
        var incoming = responseRoot(current, data);
        ['data-vf-busy', 'data-vf-refresh-seconds', 'data-vf-refresh-url'].forEach(function (attribute) {
            if (incoming.hasAttribute(attribute)) {
                current.setAttribute(attribute, incoming.getAttribute(attribute));
            }
        });

        if (!isPolling) {
            patchSection(current, incoming, 'feedback');
        }
        var hasBuildProgress = !!current.querySelector('[data-vf-build-progress]');
        if (!hasBuildProgress) {
            patchSection(current, incoming, 'task');
        }
        ['notices', 'overview', 'network', 'operating-system', 'more-features'].forEach(function (name) {
            patchSection(current, incoming, name);
        });
        updateResponseMessage(current, data, isPolling);
        syncBuildProgress(current);
        return current;
    }

    function isUserBusy(current) {
        var focused = document.activeElement;
        return document.hidden
            || current.querySelector('.modal.show')
            || current.querySelector('[data-vf-os-installer][data-vf-dirty="true"]')
            || (focused && current.contains(focused) && /^(INPUT|SELECT|TEXTAREA)$/.test(focused.tagName));
    }

    function refresh(current, isPolling) {
        return requestJson(current.getAttribute('data-vf-refresh-url') || window.location.href, {
            method: 'GET',
            credentials: 'same-origin',
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        }).then(function (data) {
            return updateManage(current, data, isPolling);
        });
    }

    function schedule(current) {
        window.clearTimeout(window.virtfusionManageRefreshTimer);
        if (!current || !current.isConnected) {
            return;
        }
        var seconds = Number(current.getAttribute('data-vf-refresh-seconds')) || 60;
        var delay = seconds === 5
            ? 5000 - (Date.now() % 5000)
            : seconds * 1000;
        window.virtfusionManageRefreshTimer = window.setTimeout(function () {
            var liveCurrent = currentRoot(current.id);
            if (!liveCurrent) {
                return;
            }
            if (isUserBusy(liveCurrent)) {
                schedule(liveCurrent);
                return;
            }
            refresh(liveCurrent, true).then(function () {
                schedule(liveCurrent);
            }).catch(function () {
                schedule(liveCurrent);
            });
        }, delay);
    }

    function submitNormally(form, submitter) {
        if (submitter && submitter.name) {
            var actionField = document.createElement('input');
            actionField.type = 'hidden';
            actionField.name = submitter.name;
            actionField.value = submitter.value;
            form.appendChild(actionField);
        }
        form.submit();
    }

    function releaseSubmittedModal(form, current) {
        var modal = form.closest('.modal') || current.querySelector('.modal.show');
        var backdrops = document.querySelectorAll('.modal-backdrop');
        if (!modal && backdrops.length === 0) {
            return;
        }
        if (modal) {
            modal.classList.remove('show');
            modal.style.display = 'none';
            modal.setAttribute('aria-hidden', 'true');
            modal.removeAttribute('aria-modal');
        }
        backdrops.forEach(function (backdrop) {
            backdrop.remove();
        });
        document.body.classList.remove('modal-open');
        document.body.style.removeProperty('padding-right');
    }

    if (!window.virtfusionManageAjaxBound) {
        window.virtfusionManageAjaxBound = true;
        document.addEventListener('submit', function (event) {
            var form = event.target;
            if (event.defaultPrevented || !form || !form.closest || form.target === '_blank') {
                return;
            }
            var current = form.closest('#tabManage, #tabAdminManage');
            if (!current) {
                return;
            }

            event.preventDefault();
            window.clearTimeout(window.virtfusionManageRefreshTimer);
            var submitter = event.submitter || document.activeElement;
            var formData = new FormData(form);
            if (submitter && submitter.name && !formData.has(submitter.name)) {
                formData.append(submitter.name, submitter.value);
            }
            if (submitter) {
                submitter.disabled = true;
            }

            requestJson(form.getAttribute('action') || window.location.href, {
                method: 'POST',
                body: formData,
                credentials: 'same-origin',
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            }).then(function (data) {
                releaseSubmittedModal(form, current);
                updateManage(current, data, false);
                schedule(current);
            }).catch(function () {
                submitNormally(form, submitter);
            });
        });

        document.addEventListener('click', function (event) {
            var refreshButton = event.target.closest && event.target.closest('[data-vf-build-refresh]');
            if (!refreshButton) {
                return;
            }
            var current = refreshButton.closest('#tabManage, #tabAdminManage');
            if (!current) {
                return;
            }
            event.preventDefault();
            refreshButton.disabled = true;
            window.clearTimeout(window.virtfusionManageRefreshTimer);
            refresh(current, true).then(function () {
                var progress = current.querySelector('[data-vf-build-progress]');
                if (progress) {
                    progress.remove();
                }
                schedule(current);
            }).catch(function () {
                refreshButton.disabled = false;
                schedule(current);
            });
        });
    }

    var initial = document.querySelector('#tabManage, #tabAdminManage');
    syncBuildProgress(initial);
    schedule(initial);
}());
</script>
