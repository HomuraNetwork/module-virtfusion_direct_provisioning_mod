<style>
.vf-server-actions { padding: 1rem 1.25rem 1.25rem; border-bottom: 1px solid #dee2e6; }
.vf-server-action-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.vf-server-action-list + .vf-server-action-list { margin-top: 0.5rem; padding-top: 0.75rem; border-top: 1px solid #e9ecef; }
.vf-server-action-item { flex: 1 1 9.5rem; min-width: 0; }
.vf-server-action-item form { height: 100%; }
.vf-server-action-item .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 2.5rem; }
.vf-server-secondary-section { padding-top: 1rem; border-top: 1px solid #dee2e6; }
@media (max-width: 575.98px) {
    .vf-server-action-item { flex-basis: calc(50% - 0.25rem); }
}
</style>
<section class="vf-server-actions" aria-labelledby="virtfusionServerActionsHeading">
    <div class="mb-2">
        <strong id="virtfusionServerActionsHeading"><?php $this->_('VirtfusionDirectProvisioningMod.tabManage.actions'); ?></strong>
    </div>
    <div class="vf-server-action-list" data-vf-action-row="power">
        <div class="vf-server-action-item" data-vf-power-visible="stopped" <?php echo $running === false ? '' : 'hidden'; ?>>
            <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                <button type="submit" name="action" value="boot" class="btn btn-outline-secondary w-100" <?php echo $power_locked ? 'disabled' : ''; ?>>
                    <i class="fas fa-play" aria-hidden="true"></i>
                    <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.boot'); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
        <?php foreach (['restart', 'shutdown', 'poweroff'] as $vf_power_action) { ?>
        <div class="vf-server-action-item" data-vf-power-visible="running" <?php echo $running === true ? '' : 'hidden'; ?>>
            <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                <button
                    type="submit"
                    name="action"
                    value="<?php echo $vf_power_action; ?>"
                    class="btn <?php echo $vf_power_action === 'poweroff' ? 'btn-outline-danger' : 'btn-outline-secondary'; ?> w-100"
                    data-vf-confirm="<?php echo $this->Html->safe($confirm_power); ?>"
                    <?php echo $vf_power_action === 'poweroff' ? 'data-vf-confirm-danger="true"' : ''; ?>
                    <?php echo $power_locked ? 'disabled' : ''; ?>
                >
                    <i class="fas <?php echo $vf_power_action === 'restart' ? 'fa-redo-alt' : ($vf_power_action === 'shutdown' ? 'fa-stop' : 'fa-power-off'); ?>" aria-hidden="true"></i>
                    <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.' . $vf_power_action); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
        <?php } ?>
    </div>
    <div class="vf-server-action-list" data-vf-action-row="maintenance">
        <div class="vf-server-action-item">
            <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                <button type="submit" name="action" value="vnc" class="btn btn-outline-primary w-100" data-vf-task-lockable <?php echo $tasks_locked ? 'disabled' : ''; ?>>
                    <i class="fas fa-desktop" aria-hidden="true"></i>
                    <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.vnc_console'); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
        <div class="vf-server-action-item">
            <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                <button
                    type="submit"
                    name="action"
                    value="resetpass"
                    class="btn btn-outline-secondary w-100"
                    data-vf-task-lockable
                    data-vf-confirm="<?php echo $this->Html->safe($confirm_password); ?>"
                    <?php echo $tasks_locked ? 'disabled' : ''; ?>
                >
                    <i class="fas fa-key" aria-hidden="true"></i>
                    <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.reset_password'); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
        <?php include __DIR__ . '/os_install.pdt'; ?>
    </div>
</section>
<?php include __DIR__ . '/action_confirm.pdt'; ?>
