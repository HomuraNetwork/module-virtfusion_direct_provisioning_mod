<?php
$primary_ipv4 = $ip_data->ip_addresses['main'][0] ?? null;
$other_ipv4 = array_merge(
    $ip_data->ip_addresses['base'] ?? [],
    $ip_data->ip_addresses['extra'] ?? []
);
$ipv6 = $ip_data->ip_addresses['ipv6'][0] ?? null;
?>
<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th><?php $this->_('VirtfusionDirectProvisioningMod.service_info.server_id'); ?></th>
                <th><?php $this->_('VirtfusionDirectProvisioningMod.service_info.main_ip'); ?></th>
                <th><?php $this->_('VirtfusionDirectProvisioningMod.service_info.secondary_ipv4'); ?></th>
                <th><?php $this->_('VirtfusionDirectProvisioningMod.ipAddresses.ipv6'); ?></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><?php echo $this->Html->safe($service_fields->virtfusion_server_id ?? '—'); ?></td>
                <td><code><?php echo $this->Html->safe($primary_ipv4 ?? '—'); ?></code></td>
                <td><?php echo !empty($other_ipv4)
                    ? $this->Html->safe(implode(', ', $other_ipv4))
                    : '—'; ?></td>
                <td><code><?php echo $this->Html->safe($ipv6 ?? '—'); ?></code></td>
            </tr>
        </tbody>
    </table>
</div>
