<?php
$vf_network = $server_info->network_addresses ?? (object) ['ipv4' => [], 'ipv6_blocks' => []];
?>
<div class="card mb-3">
    <div class="card-header">
        <strong><?php $this->_('VirtfusionDirectProvisioningMod.service_info.network'); ?></strong>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <?php foreach ([
                'ipv4' => $vf_network->ipv4 ?? [],
                'ipv6_blocks' => $vf_network->ipv6_blocks ?? []
            ] as $vf_address_type => $vf_addresses) { ?>
                <div class="col-md-6">
                    <div class="small text-muted mb-2"><?php $this->_('VirtfusionDirectProvisioningMod.ipAddresses.' . $vf_address_type); ?></div>
                    <?php if (empty($vf_addresses)) { ?>
                        <span class="text-muted"><?php $this->_('VirtfusionDirectProvisioningMod.ipAddresses.none'); ?></span>
                    <?php } else { ?>
                        <ul class="list-unstyled mb-0">
                            <?php foreach ($vf_addresses as $vf_address) { ?>
                                <li class="mb-2"><code class="text-break"><?php echo $this->Html->safe($vf_address); ?></code></li>
                            <?php } ?>
                        </ul>
                    <?php } ?>
                </div>
            <?php } ?>
        </div>
        <div class="row g-3 mt-1 pt-3 border-top">
            <div class="col-md-6 d-flex justify-content-between gap-3">
                <span class="text-muted"><?php $this->_('VirtfusionDirectProvisioningMod.service_info.port_speed_inbound'); ?></span>
                <strong><?php echo $this->Html->safe($server_info->network_in ?? ($empty_value ?? '—')); ?></strong>
            </div>
            <div class="col-md-6 d-flex justify-content-between gap-3">
                <span class="text-muted"><?php $this->_('VirtfusionDirectProvisioningMod.service_info.port_speed_outbound'); ?></span>
                <strong><?php echo $this->Html->safe($server_info->network_out ?? ($empty_value ?? '—')); ?></strong>
            </div>
        </div>
    </div>
</div>
