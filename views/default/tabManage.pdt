<?php
$server_available = isset($server_info);
$server_unbuilt = $server_available && empty($server_info->built);
$server_busy = $server_available && !empty($server_info->has_active_tasks);
$tasks_locked = $server_available && !empty($server_info->tasks_active);
$running = $server_available && isset($server_info->power) ? (bool) $server_info->power : null;
$power_locked = !$server_available || !empty($server_info->has_active_tasks) || $running === null;
$confirm_power = Language::_('VirtfusionDirectProvisioningMod.confirm.power', true);
$confirm_password = Language::_('VirtfusionDirectProvisioningMod.confirm.reset_password', true);
$empty_value = '—';
?>

<div
    id="tabManage"
    class="<?php echo $server_busy ? 'vf-task-waiting' : ''; ?>"
    data-vf-refresh-seconds="<?php echo $server_busy ? 5 : 60; ?>"
    data-vf-refresh-url="<?php echo $this->Html->safe($_SERVER['REQUEST_URI']); ?>"
>
    <?php if (!empty($message)) { ?>
        <div class="alert alert-info mb-4"><?php echo $this->Html->safe($message); ?></div>
    <?php } ?>
    <?php if (!empty($action_result)) { include __DIR__ . '/action_result.pdt'; } ?>
    <div class="d-flex justify-content-end mb-3">
        <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
            <button type="submit" name="action" value="refresh_ips" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('VirtfusionDirectProvisioningMod.tabManage.refresh_state'); ?>" aria-label="<?php $this->_('VirtfusionDirectProvisioningMod.tabManage.refresh_state'); ?>" <?php echo $server_busy ? 'disabled' : ''; ?>><i class="fas fa-sync-alt" aria-hidden="true"></i></button>
        <?php $this->Form->end(); ?>
    </div>

    <?php if ($server_unbuilt) { ?>
    <?php include __DIR__ . '/os_install.pdt'; ?>
    <div class="mb-3">
        <?php $this->Form->create($_SERVER['REQUEST_URI'], ['target' => '_blank']); ?>
            <button type="submit" name="action" value="manage" class="btn btn-primary w-100">
                <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.manage'); ?>
            </button>
        <?php $this->Form->end(); ?>
    </div>
    <?php } else { ?>

    <?php if (!empty($server_info->has_pending_tasks)) { ?>
        <div class="alert alert-warning mb-4">
            <div><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.tasks.pending_restart', true)); ?></div>
            <ul class="mb-0 mt-2">
                <?php foreach ($server_info->pending_tasks as $pending_task) { ?>
                    <li><?php echo $this->Html->safe($pending_task); ?></li>
                <?php } ?>
            </ul>
        </div>
    <?php } ?>
    <?php if (!empty($storage_mismatch)) { ?>
        <div class="alert alert-danger mb-4">
            <div><?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.storage.ticket_required', true)); ?></div>
            <div class="mt-2">
                <strong><?php $this->_('VirtfusionDirectProvisioningMod.storage.expected'); ?>:</strong>
                <?php echo $this->Html->safe($storage_mismatch->expected); ?> GB
                <span class="mx-2">|</span>
                <strong><?php $this->_('VirtfusionDirectProvisioningMod.storage.actual'); ?>:</strong>
                <?php echo $this->Html->safe($storage_mismatch->actual); ?> GB
            </div>
            <a href="<?php echo $this->Html->safe($support_ticket_url); ?>" class="btn btn-danger btn-sm mt-3">
                <?php $this->_('VirtfusionDirectProvisioningMod.storage.open_ticket'); ?>
            </a>
        </div>
    <?php } ?>
    <?php if (($service_fields->virtfusion_build_state ?? '') === 'failed_or_unknown') { ?>
        <div class="alert alert-warning mb-4">
            <?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.build_reconciliation_required', true)); ?>
        </div>
    <?php } ?>
    <?php if ($server_available) { include __DIR__ . '/server_overview.pdt'; } ?>

    <?php include __DIR__ . '/network_addresses.pdt'; ?>

    <div class="row g-2 mb-3">
        <div class="col-md-6">
            <?php $this->Form->create($_SERVER['REQUEST_URI'], ['target' => '_blank']); ?>
                <button type="submit" name="action" value="manage" class="btn btn-primary w-100">
                    <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.manage'); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
        <div class="col-md-6">
            <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                <button type="submit" name="action" value="vnc" class="btn btn-outline-primary w-100" <?php echo $tasks_locked ? 'disabled' : ''; ?>>
                    <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.vnc_console'); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <strong><?php $this->_('VirtfusionDirectProvisioningMod.tabManage.actions'); ?></strong>
        </div>
        <div class="card-body">
            <div class="row g-2">
                <?php if ($running === false) { ?>
                <div class="col-sm-6 col-lg-3">
                    <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                        <button type="submit" name="action" value="boot" class="btn btn-outline-secondary w-100" <?php echo $power_locked ? 'disabled' : ''; ?>>
                            <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.boot'); ?>
                        </button>
                    <?php $this->Form->end(); ?>
                </div>
                <?php } elseif ($running === true) { ?>
                <div class="col-sm-6 col-lg-3">
                    <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                        <button type="submit" name="action" value="restart" class="btn btn-outline-secondary w-100" onclick="return confirm(<?php echo $this->Html->safe(json_encode($confirm_power)); ?>);" <?php echo $power_locked ? 'disabled' : ''; ?>>
                            <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.restart'); ?>
                        </button>
                    <?php $this->Form->end(); ?>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                        <button type="submit" name="action" value="shutdown" class="btn btn-outline-secondary w-100" onclick="return confirm(<?php echo $this->Html->safe(json_encode($confirm_power)); ?>);" <?php echo $power_locked ? 'disabled' : ''; ?>>
                            <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.shutdown'); ?>
                        </button>
                    <?php $this->Form->end(); ?>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                        <button type="submit" name="action" value="poweroff" class="btn btn-outline-danger w-100" onclick="return confirm(<?php echo $this->Html->safe(json_encode($confirm_power)); ?>);" <?php echo $power_locked ? 'disabled' : ''; ?>>
                            <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.poweroff'); ?>
                        </button>
                    <?php $this->Form->end(); ?>
                </div>
                <?php } ?>
                <div class="col-sm-6 col-lg-3">
                    <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                        <button type="submit" name="action" value="resetpass" class="btn btn-outline-secondary w-100" onclick="return confirm(<?php echo $this->Html->safe(json_encode($confirm_password)); ?>);" <?php echo $tasks_locked ? 'disabled' : ''; ?>>
                            <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.reset_password'); ?>
                        </button>
                    <?php $this->Form->end(); ?>
                </div>
            </div>
        </div>
    </div>
    <?php include __DIR__ . '/os_install.pdt'; ?>
    <?php } ?>

    <?php if ($server_busy) { ?>
    <style>
        #tabManage.vf-task-waiting { position: relative; min-height: 22rem; }
        #tabManage .vf-task-overlay {
            position: absolute;
            inset: 0;
            z-index: 20;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 1.5rem;
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(2px);
        }
        #tabManage .vf-task-overlay-content { width: min(100%, 34rem); margin-top: 3rem; text-align: center; }
        #tabManage .vf-task-spinner {
            width: 2.5rem;
            height: 2.5rem;
            margin: 0 auto 1rem;
            border: 0.25rem solid #d9e2ec;
            border-top-color: #0d6efd;
            border-radius: 50%;
            animation: vf-task-spin 0.8s linear infinite;
        }
        #tabManage .vf-task-progress { height: 0.5rem; margin: 1.25rem 0 0.5rem; overflow: hidden; background: #d9e2ec; border-radius: 0.25rem; }
        #tabManage .vf-task-progress-bar { width: 42%; height: 100%; background: #0d6efd; animation: vf-task-scroll 1.15s ease-in-out infinite; }
        @keyframes vf-task-spin { to { transform: rotate(360deg); } }
        @keyframes vf-task-scroll { from { transform: translateX(-110%); } to { transform: translateX(350%); } }
    </style>
    <div class="vf-task-overlay" role="status" aria-live="polite" aria-busy="true">
        <div class="vf-task-overlay-content">
            <div class="vf-task-spinner" aria-hidden="true"></div>
            <div class="fw-semibold mb-2">
                <?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.tasks.building', true)); ?>
            </div>
            <div class="vf-task-progress" aria-hidden="true"><div class="vf-task-progress-bar"></div></div>
            <div class="text-muted small mb-3">
                <?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.tasks.refreshing', true)); ?>
            </div>
            <?php $this->Form->create($_SERVER['REQUEST_URI'], ['target' => '_blank']); ?>
                <button type="submit" name="action" value="manage" class="btn btn-primary">
                    <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.manage'); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
    </div>
    <?php } ?>
    <?php include __DIR__ . '/manage_ajax.pdt'; ?>
</div>
