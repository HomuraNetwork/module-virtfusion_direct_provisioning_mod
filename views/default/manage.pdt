<?php /** @var View $this **/ ?>

<?php if (!empty($sync_result)) { ?>
<div class="alert alert-<?php echo $sync_result['success'] ? 'success' : 'danger'; ?>">
    <?php echo $this->Html->safe($sync_result['message']); ?>
    <?php if ($sync_result['success']) { ?>
        <a class="alert-link" href="<?php echo $this->Html->safe(
            $this->base_uri . 'settings/company/modules/manage/' . $sync_result['module_id']
        ); ?>">
            <?php $this->_('VirtfusionDirectProvisioningMod.sync.open_destination'); ?>
        </a>
    <?php } ?>
</div>
<?php } ?>

<div class="mb-4">
    <h5><?php $this->_('VirtfusionDirectProvisioningMod.sync.heading'); ?></h5>
    <p class="text-muted"><?php $this->_('VirtfusionDirectProvisioningMod.sync.description'); ?></p>
    <div class="d-flex flex-wrap gap-2">
        <?php $this->Form->create(); ?>
        <?php $this->Form->fieldHidden('sync_action', 'from_official'); ?>
        <button type="submit" class="btn btn-outline-primary" onclick="return confirm('<?php echo $this->Html->safe(
            $this->_('VirtfusionDirectProvisioningMod.sync.confirm.from_official', true)
        ); ?>');">
            <i class="bi bi-arrow-right-circle me-1"></i>
            <?php $this->_('VirtfusionDirectProvisioningMod.sync.from_official'); ?>
        </button>
        <?php $this->Form->end(); ?>

        <?php $this->Form->create(); ?>
        <?php $this->Form->fieldHidden('sync_action', 'to_official'); ?>
        <button type="submit" class="btn btn-outline-secondary" onclick="return confirm('<?php echo $this->Html->safe(
            $this->_('VirtfusionDirectProvisioningMod.sync.confirm.to_official', true)
        ); ?>');">
            <i class="bi bi-arrow-left-circle me-1"></i>
            <?php $this->_('VirtfusionDirectProvisioningMod.sync.to_official'); ?>
        </button>
        <?php $this->Form->end(); ?>
    </div>
</div>

<?php
$link_buttons = [
    [
        'name' => $this->_('VirtfusionDirectProvisioningMod.add_module_row', true),
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . $module->id],
    ],
];

$this->Widget->clear();
$this->Widget->setLinkButtons($link_buttons);
$this->Widget->setBodyWrapper(false);

$this->Widget->create(
    $this->_(
        'AdminCompanyModules.manage.boxtitle_manage',
        true,
        isset($module->name) ? $this->Html->safe($module->name, true) : null,
    ),
    ['id' => 'manage_virtfusion_direct_provisioning_mod'],
);
?>
        <?php
        $num_rows = count(isset($module->rows) ? $module->rows : []);
        if ($num_rows > 0) { ?>
<table class="table">
    <thead>
        <tr>
            <th><span><?php $this->_('VirtfusionDirectProvisioningMod.manage.module_rows_heading.name'); ?></span></th>
            <th><span><?php $this->_('VirtfusionDirectProvisioningMod.manage.module_rows_heading.options'); ?></span></th>
        </tr>
    </thead>
    <tbody>
        <?php for ($i = 0; $i < $num_rows; $i++) { ?>
        <tr>
            <td><?php echo isset($module->rows[$i]->meta->name)
                ? $this->Html->safe($module->rows[$i]->meta->name)
                : null; ?></td>
            <td>
                <a href="<?php echo $this->Html->safe(
                    $this->base_uri .
                        'settings/company/modules/editrow/' .
                        (isset($module->id) ? $module->id : null) .
                        '/' .
                        (isset($module->rows[$i]->id) ? $module->rows[$i]->id : null) .
                        '/',
                ); ?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_(
    'VirtfusionDirectProvisioningMod.manage.module_rows.edit',
); ?>">
                    <i class="bi bi-pencil"></i>
                </a>
                <?php
                $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/', ['class' => 'd-inline']);
                $this->Form->fieldHidden('id', isset($module->id) ? $module->id : null);
                $this->Form->fieldHidden('row_id', isset($module->rows[$i]->id) ? $module->rows[$i]->id : null);
                ?>
                <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete"
                    data-confirm-message="<?php echo $this->Html->safe(
                        $this->_('VirtfusionDirectProvisioningMod.manage.module_rows.confirm_delete', true),
                    ); ?>"
                    title="<?php $this->_('VirtfusionDirectProvisioningMod.manage.module_rows.delete'); ?>">
                    <i class="bi bi-trash"></i>
                </button>
                <?php $this->Form->end(); ?>
            </td>
        </tr>
                <?php } ?>
    </tbody>
</table>
                <?php } else { ?>
<div class="card-body text-center text-muted py-5">
    <i class="bi bi-server" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('VirtfusionDirectProvisioningMod.manage.module_rows_no_results'); ?></p>
</div>
                <?php }

        $this->Widget->end();
        ?>
