                        data-vf-confirm="<?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.confirm.reinstall', true)); ?>"
                        data-vf-confirm-danger="true"
                        data-vf-task-lockable
                        <?php echo $tasks_locked ? 'disabled' : ''; ?>
                    >
                        <i class="fas fa-sync-alt" aria-hidden="true"></i>
                        <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.reinstall_button'); ?>
