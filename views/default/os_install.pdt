<?php
$vf_is_reinstall = !empty($server_info->built);
$vf_os_action = $vf_is_reinstall ? 'rebuild' : 'build';
$vf_os_prefix = isset($admin_server_url) ? 'virtfusionAdminOs' : 'virtfusionClientOs';
$vf_os_catalog = [];
foreach (($server_info->os_templates ?? []) as $vf_template_group) {
    $vf_group_templates = [];
    foreach (($vf_template_group->templates ?? []) as $vf_template) {
        $vf_group_templates[] = [
            'id' => (int) $vf_template->id,
            'label' => (string) $vf_template->label
        ];
    }
    if (!empty($vf_group_templates)) {
        $vf_os_catalog[] = [
            'name' => (string) $vf_template_group->name,
            'templates' => $vf_group_templates
        ];
    }
}
?>
<?php if (!empty($vf_os_catalog)) { ?>
<?php if ($vf_is_reinstall) { ?>
<div class="vf-server-action-item">
    <button
        type="button"
        class="btn btn-outline-danger w-100"
        data-vf-os-open="<?php echo $vf_os_prefix; ?>"
        <?php echo $tasks_locked ? 'disabled' : ''; ?>
    >
        <i class="fas fa-compact-disc" aria-hidden="true"></i>
        <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.reinstall_button'); ?>
    </button>
</div>
<div
    class="modal fade vf-os-modal"
    id="<?php echo $vf_os_prefix; ?>Modal"
    tabindex="-1"
    role="dialog"
    aria-labelledby="<?php echo $vf_os_prefix; ?>Heading"
    aria-hidden="true"
    data-vf-os-installer="<?php echo $vf_os_prefix; ?>"
>
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="<?php echo $vf_os_prefix; ?>Heading">
                    <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.reinstall'); ?>
                </h5>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-vf-os-close aria-label="Close">&times;</button>
            </div>
            <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                <div class="modal-body">
                    <div class="alert alert-danger">
                        <?php echo $this->Html->safe(Language::_('VirtfusionDirectProvisioningMod.confirm.reinstall', true)); ?>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="<?php echo $vf_os_prefix; ?>Category">
                            <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.os_family'); ?>
                        </label>
                        <select class="form-control form-select" id="<?php echo $vf_os_prefix; ?>Category" data-vf-os-category required>
                            <option value=""><?php $this->_('VirtfusionDirectProvisioningMod.tabManage.select_os_family'); ?></option>
                            <?php foreach ($vf_os_catalog as $vf_group_index => $vf_group) { ?>
                                <option value="<?php echo (int) $vf_group_index; ?>"><?php echo $this->Html->safe($vf_group['name']); ?></option>
                            <?php } ?>
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="<?php echo $vf_os_prefix; ?>Template">
                            <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.os_template'); ?>
                        </label>
                        <select class="form-control form-select" id="<?php echo $vf_os_prefix; ?>Template" name="operating_system_id" data-vf-os-template required disabled>
                            <option value=""><?php $this->_('VirtfusionDirectProvisioningMod.tabManage.select_os_template'); ?></option>
                        </select>
                    </div>
                    <?php include __DIR__ . '/os_build_options.pdt'; ?>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-vf-os-close>
                        <?php $this->_('VirtfusionDirectProvisioningMod.confirm.cancel'); ?>
                    </button>
                    <button type="submit" name="action" value="rebuild" class="btn btn-danger" data-vf-os-submit disabled>
                        <i class="fas fa-sync-alt" aria-hidden="true"></i>
                        <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.reinstall_button'); ?>
                    </button>
                </div>
            <?php $this->Form->end(); ?>
        </div>
    </div>
    <script type="application/json" data-vf-os-catalog><?php echo json_encode(
        $vf_os_catalog,
        JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    ); ?></script>
</div>
<?php } else { ?>
<div class="card mb-3" data-vf-os-installer="<?php echo $vf_os_prefix; ?>">
    <div class="card-header">
        <strong><?php $this->_('VirtfusionDirectProvisioningMod.tabManage.install'); ?></strong>
    </div>
    <div class="card-body">
        <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="<?php echo $vf_os_prefix; ?>Category">
                        <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.os_family'); ?>
                    </label>
                    <select class="form-control form-select" id="<?php echo $vf_os_prefix; ?>Category" data-vf-os-category required <?php echo $tasks_locked ? 'disabled' : ''; ?>>
                        <option value=""><?php $this->_('VirtfusionDirectProvisioningMod.tabManage.select_os_family'); ?></option>
                        <?php foreach ($vf_os_catalog as $vf_group_index => $vf_group) { ?>
                            <option value="<?php echo (int) $vf_group_index; ?>"><?php echo $this->Html->safe($vf_group['name']); ?></option>
                        <?php } ?>
                    </select>
                </div>
                <div class="col-md">
                    <label class="form-label" for="<?php echo $vf_os_prefix; ?>Template">
                        <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.os_template'); ?>
                    </label>
                    <select class="form-control form-select" id="<?php echo $vf_os_prefix; ?>Template" name="operating_system_id" data-vf-os-template required disabled>
                        <option value=""><?php $this->_('VirtfusionDirectProvisioningMod.tabManage.select_os_template'); ?></option>
                    </select>
                </div>
                <div class="col-md-auto">
                    <button type="submit" name="action" value="build" class="btn btn-primary w-100" data-vf-os-submit disabled>
                        <i class="fas fa-play" aria-hidden="true"></i>
                        <?php $this->_('VirtfusionDirectProvisioningMod.tabManage.install_button'); ?>
                    </button>
                </div>
            </div>
            <?php include __DIR__ . '/os_build_options.pdt'; ?>
        <?php $this->Form->end(); ?>
    </div>
    <script type="application/json" data-vf-os-catalog><?php echo json_encode(
        $vf_os_catalog,
        JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    ); ?></script>
</div>
<?php } ?>
<script type="text/javascript">
(function () {
    var installer = document.querySelector('[data-vf-os-installer="<?php echo $vf_os_prefix; ?>"]');
    if (!installer) {
        return;
    }
    var category = installer.querySelector('[data-vf-os-category]');
    var template = installer.querySelector('[data-vf-os-template]');
    var submit = installer.querySelector('[data-vf-os-submit]');
    var catalogElement = installer.querySelector('[data-vf-os-catalog]');
    var openButton = document.querySelector('[data-vf-os-open="<?php echo $vf_os_prefix; ?>"]');
    var hostname = installer.querySelector('[data-vf-hostname]');
    var form = installer.querySelector('form');
    var authModeInputs = installer.querySelectorAll('[data-vf-auth-mode]');
    var keyAuthControls = installer.querySelectorAll('[data-vf-key-auth-control]');
    var sshKeyCheckboxes = installer.querySelectorAll('input[name="ssh_key_ids[]"]');
    var importToggle = installer.querySelector('[data-vf-ssh-import-toggle]');
    var importPanel = installer.querySelector('[data-vf-ssh-import-panel]');
    var keyName = installer.querySelector('[data-vf-ssh-key-name]');
    var publicKey = installer.querySelector('[data-vf-ssh-public-key]');
    var initialHostname = hostname ? hostname.value : '';
    var initialImport = importToggle ? importToggle.checked : false;
    var emptyLabel = <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.tabManage.select_os_template', true)); ?>;
    var sshKeyRequired = <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.!error.rebuild.ssh_key_required', true)); ?>;
    var catalog = [];
    try {
        catalog = JSON.parse(catalogElement.textContent || '[]');
    } catch (error) {
        return;
    }

    function resetTemplates() {
        template.replaceChildren();
        var placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = emptyLabel;
        template.appendChild(placeholder);
    }

    function resetInstaller() {
        category.value = '';
        resetTemplates();
        template.disabled = true;
        submit.disabled = true;
        if (hostname) {
            hostname.value = initialHostname;
        }
        sshKeyCheckboxes.forEach(function (checkbox) {
            checkbox.checked = false;
        });
        authModeInputs.forEach(function (input) {
            input.checked = input.getAttribute('data-vf-auth-mode') === 'ssh';
        });
        if (importToggle) {
            importToggle.checked = initialImport;
        }
        [keyName, publicKey].forEach(function (field) {
            if (field) {
                field.value = '';
                field.disabled = true;
                field.required = false;
                field.setCustomValidity('');
            }
        });
        syncAuthenticationMode();
        installer.removeAttribute('data-vf-dirty');
    }

    function markDirty() {
        var sshKeySelected = Array.prototype.some.call(sshKeyCheckboxes, function (checkbox) {
            return checkbox.checked;
        });
        if (category.value !== '' || template.value !== '' || sshKeySelected
            || (hostname && hostname.value !== initialHostname)
            || (importToggle && importToggle.checked !== initialImport)
            || usingPasswordLogin()) {
            installer.setAttribute('data-vf-dirty', 'true');
        } else {
            installer.removeAttribute('data-vf-dirty');
        }
    }

    function usingPasswordLogin() {
        var selected = installer.querySelector('[data-vf-auth-mode]:checked');
        return selected && selected.getAttribute('data-vf-auth-mode') === 'password';
    }

    function syncAuthenticationMode() {
        var usePassword = usingPasswordLogin();
        authModeInputs.forEach(function (input) {
            var choice = input.closest('.vf-auth-choice');
            if (choice) {
                choice.classList.toggle('is-selected', input.checked);
            }
        });
        keyAuthControls.forEach(function (control) {
            control.classList.toggle('text-muted', usePassword);
            control.setAttribute('aria-disabled', usePassword ? 'true' : 'false');
        });
        sshKeyCheckboxes.forEach(function (checkbox) {
            checkbox.disabled = usePassword;
        });
        if (importToggle) {
            importToggle.disabled = usePassword;
            importToggle.setCustomValidity('');
        }
        if (importPanel) {
            importPanel.hidden = usePassword || !importToggle || !importToggle.checked;
        }
        [keyName, publicKey].forEach(function (field) {
            if (!field) {
                return;
            }
            var enabled = !usePassword && importToggle && importToggle.checked;
            field.disabled = !enabled;
            field.required = enabled;
            if (!enabled) {
                field.setCustomValidity('');
            }
        });
    }

    function clearAuthenticationError() {
        if (importToggle) {
            importToggle.setCustomValidity('');
        }
    }

    function showInstaller() {
        if (window.bootstrap && window.bootstrap.Modal
            && typeof window.bootstrap.Modal.getOrCreateInstance === 'function') {
            window.bootstrap.Modal.getOrCreateInstance(installer, {backdrop: true, keyboard: true}).show();
            return;
        }
        if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
            window.jQuery(installer).modal({backdrop: true, keyboard: true, show: true});
            return;
        }
        installer.style.display = 'block';
        installer.classList.add('show');
        installer.removeAttribute('aria-hidden');
        installer.setAttribute('aria-modal', 'true');
    }

    function hideInstaller() {
        if (window.bootstrap && window.bootstrap.Modal
            && typeof window.bootstrap.Modal.getOrCreateInstance === 'function') {
            window.bootstrap.Modal.getOrCreateInstance(installer).hide();
        } else if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
            window.jQuery(installer).modal('hide');
        } else {
            installer.style.display = 'none';
            installer.classList.remove('show');
            installer.setAttribute('aria-hidden', 'true');
            installer.removeAttribute('aria-modal');
        }
        resetInstaller();
    }

    category.addEventListener('change', function () {
        resetTemplates();
        var group = category.value === '' ? null : catalog[Number(category.value)];
        (group && group.templates ? group.templates : []).forEach(function (item) {
            var option = document.createElement('option');
            option.value = String(item.id);
            option.textContent = item.label;
            template.appendChild(option);
        });
        template.disabled = !group || !group.templates || group.templates.length === 0;
        submit.disabled = true;
        markDirty();
    });
    template.addEventListener('change', function () {
        submit.disabled = template.value === '';
        markDirty();
    });
    if (hostname) {
        hostname.addEventListener('input', markDirty);
    }
    sshKeyCheckboxes.forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
            clearAuthenticationError();
            markDirty();
        });
    });
    authModeInputs.forEach(function (input) {
        input.addEventListener('change', function () {
            clearAuthenticationError();
            syncAuthenticationMode();
            markDirty();
        });
    });
    if (importToggle && importPanel && keyName && publicKey) {
        importToggle.addEventListener('change', function () {
            var enabled = importToggle.checked && !usingPasswordLogin();
            clearAuthenticationError();
            syncAuthenticationMode();
            if (!enabled) {
                keyName.value = '';
                publicKey.value = '';
                publicKey.setCustomValidity('');
            }
            markDirty();
        });
        publicKey.addEventListener('input', function () {
            var value = publicKey.value.trim();
            var valid = /^(ssh-(rsa|ed25519)|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com)\s+[A-Za-z0-9+/]+={0,3}(\s+[^\r\n]*)?$/.test(value);
            publicKey.setCustomValidity(value === '' || valid ? '' : <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.!error.rebuild.ssh_public_key', true)); ?>);
        });
    }
    if (form) {
        form.addEventListener('submit', function (event) {
            var usePassword = usingPasswordLogin();
            var selectedKey = Array.prototype.some.call(sshKeyCheckboxes, function (checkbox) {
                return checkbox.checked;
            });
            var importingKey = importToggle && importToggle.checked;
            if (!usePassword && !selectedKey && !importingKey && importToggle) {
                event.preventDefault();
                importToggle.setCustomValidity(sshKeyRequired);
                importToggle.reportValidity();
            }
        });
    }

    syncAuthenticationMode();

    if (openButton) {
        openButton.addEventListener('click', showInstaller);
        installer.querySelectorAll('[data-vf-os-close]').forEach(function (button) {
            button.addEventListener('click', hideInstaller);
        });
        installer.addEventListener('click', function (event) {
            if (event.target === installer && !window.bootstrap && !(window.jQuery && window.jQuery.fn.modal)) {
                hideInstaller();
            }
        });
        if (window.bootstrap && window.bootstrap.Modal) {
            installer.addEventListener('hidden.bs.modal', resetInstaller);
        } else if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
            window.jQuery(installer).on('hidden.bs.modal', resetInstaller);
        }
    }
}());
</script>
<?php } ?>
