<script type="text/javascript">
(function () {
    var modal = document.getElementById('virtfusionBuildStatusModal');
    if (modal) {
        modal.querySelectorAll('[data-vf-build-close]').forEach(function (button) {
            button.addEventListener('click', function () {
                window.virtfusionResultModal.remove(modal);
            });
        });
        window.virtfusionResultModal.show(modal);
    }
    document.querySelectorAll('[data-vf-copy-field]').forEach(function (button) {
        if (button.getAttribute('data-vf-copy-bound') === 'true') {
            return;
        }
        button.setAttribute('data-vf-copy-bound', 'true');
        button.addEventListener('click', function () {
            var field = document.getElementById(button.getAttribute('data-vf-copy-field'));
            if (!field) {
                return;
            }
            var copied = function () {
                button.textContent = <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.password_result.copied', true)); ?>;
            };
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(field.value).then(copied);
                return;
            }
            field.select();
            document.execCommand('copy');
            copied();
        });
    });
}());
</script>
