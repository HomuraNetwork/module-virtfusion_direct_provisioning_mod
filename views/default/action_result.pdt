        </div>
</div>
<script type="text/javascript">
(function () {
    var button = document.getElementById('virtfusionCopyPassword');
    var field = document.getElementById('virtfusionNewPassword');
    if (!button || !field) {
        return;
    }

    button.addEventListener('click', function () {
        var copied = function () {
            button.textContent = <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.password_result.copied', true)); ?>;
        };

        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(field.value).then(copied);
            return;
        }

        field.select();
        document.execCommand('copy');
        copied();
    });
    var modal = document.getElementById('virtfusionPasswordResultModal');
    if (modal) {
        modal.querySelectorAll('[data-vf-result-close]').forEach(function (closeButton) {
            closeButton.addEventListener('click', function () {
                window.virtfusionResultModal.remove(modal);
            });
        });
        window.virtfusionResultModal.show(modal);
    }

    var result = document.querySelector('[data-vf-password-result]');
    var statusForm = result && result.querySelector('[data-vf-password-status-form] form');
    if (!result || !statusForm || !window.fetch || !window.FormData) {
        return;
    }

    var unavailableChecks = 0;
    function finishStatus(status) {
        result.setAttribute('aria-busy', 'false');
        result.classList.remove('alert-info', 'border-info', 'alert-success', 'border-success', 'alert-danger', 'border-danger', 'alert-warning', 'border-warning');
        var className = status === 'complete' ? 'success' : (status === 'failed' ? 'danger' : 'warning');
        result.classList.add('alert-' + className, 'border-' + className);
        result.querySelector('[data-vf-password-heading]').textContent = result.getAttribute('data-vf-' + status + '-heading') || '';
        result.querySelector('[data-vf-password-notice]').textContent = result.getAttribute('data-vf-' + status + '-notice') || '';
        result.querySelectorAll('[data-vf-password-active]').forEach(function (element) {
            element.hidden = true;
        });
    }

    function checkStatus() {
        if (!result.isConnected) {
            return;
        }
        window.fetch(statusForm.getAttribute('action') || window.location.href, {
            method: 'POST',
            body: new FormData(statusForm),
            credentials: 'same-origin',
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        }).then(function (response) {
            if (!response.ok) {
                throw new Error('Password status request failed.');
            }
            return response.json();
        }).then(function (data) {
            if (!data || typeof data.status !== 'string') {
                throw new Error('Password status response was missing.');
            }
            var status = data.status || 'unknown';
            var progress = Number(data.progress);
            var progressBar = result.querySelector('[data-vf-password-progress-bar]');
            if (progressBar && Number.isFinite(progress) && progress > 0) {
                progressBar.style.animation = 'none';
                progressBar.style.transform = 'none';
                progressBar.style.width = Math.min(100, progress) + '%';
            }
            if (status === 'pending') {
                unavailableChecks = 0;
                window.setTimeout(checkStatus, 5000);
                return;
            }
            if (status === 'unknown' && unavailableChecks < 2) {
                unavailableChecks += 1;
                window.setTimeout(checkStatus, 5000);
                return;
            }
            finishStatus(status);
        }).catch(function () {
            unavailableChecks += 1;
            if (unavailableChecks < 3) {
                window.setTimeout(checkStatus, 5000);
                return;
            }
            finishStatus('unknown');
        });
    }
    window.setTimeout(checkStatus, 5000);
}());
</script>
<?php } ?>

