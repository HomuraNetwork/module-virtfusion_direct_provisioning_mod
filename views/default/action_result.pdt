                <?php $this->Form->create($_SERVER['REQUEST_URI'], ['id' => 'virtfusionCloseVncForm']); ?>
                    <?php $this->Form->fieldHidden('action', 'vnc_disable'); ?>
                    <button type="button" class="btn btn-primary" id="virtfusionCloseVnc">
                        <?php $this->_('VirtfusionDirectProvisioningMod.vnc.close'); ?>
                    </button>
                <?php $this->Form->end(); ?>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
(function () {
    var noVncModuleUrl = <?php echo json_encode(VENDORWEBDIR . 'novnc/novnc/core/rfb.js'); ?>;
    var modalElement = document.getElementById('virtfusionVncModal');
    var screen = document.getElementById('virtfusionVncScreen');
    var statusElement = document.getElementById('virtfusionVncStatus');
    var ctrlAltDel = document.getElementById('virtfusionSendCtrlAltDel');
    var reconnectButton = document.getElementById('virtfusionReconnectVnc');
    var fullscreenButton = document.getElementById('virtfusionFullscreenVnc');
    var scaleToggle = document.getElementById('virtfusionScaleVnc');
    var viewOnlyToggle = document.getElementById('virtfusionViewOnlyVnc');
    var resizeToggle = document.getElementById('virtfusionResizeVnc');
    var clipboardToggle = document.getElementById('virtfusionToggleClipboard');
    var clipboardPanel = document.getElementById('virtfusionVncClipboard');
    var clipboardText = document.getElementById('virtfusionVncClipboardText');
    var clipboardStatus = document.getElementById('virtfusionVncClipboardStatus');
    var sendClipboard = document.getElementById('virtfusionSendClipboard');
    var copyClipboard = document.getElementById('virtfusionCopyClipboard');
    var closeButton = document.getElementById('virtfusionCloseVnc');
    var closeForm = document.getElementById('virtfusionCloseVncForm');
    if (!modalElement || !screen || !statusElement) {
        return;
    }

    var RFB = null;
    var rfb = null;
    var connectionState = 'disconnected';
    var disableRequested = false;

    function updateControls() {
        var connected = connectionState === 'connected';
        var viewOnly = viewOnlyToggle && viewOnlyToggle.checked;
        if (ctrlAltDel) {
            ctrlAltDel.disabled = !connected || viewOnly;
        }
        if (sendClipboard) {
            sendClipboard.disabled = !connected || viewOnly;
        }
        if (reconnectButton) {
            reconnectButton.disabled = connectionState === 'connecting';
        }
    }

    function applyDisplayPreferences(connection) {
        var scale = !scaleToggle || scaleToggle.checked;
        connection.viewOnly = Boolean(viewOnlyToggle && viewOnlyToggle.checked);
        connection.scaleViewport = scale;
        connection.clipViewport = !scale;
        connection.resizeSession = Boolean(resizeToggle && resizeToggle.checked);
        connection.focusOnClick = true;
        screen.style.overflow = scale ? 'hidden' : 'auto';
    }

    function setDisconnectedStatus(clean) {
        connectionState = 'disconnected';
        statusElement.textContent = clean
            ? <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.vnc.disconnected', true)); ?>
            : <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.vnc.failed', true)); ?>;
        updateControls();
    }

    function connect() {
        if (!RFB) {
            return;
        }

        if (rfb) {
            var previousConnection = rfb;
            rfb = null;
            previousConnection.disconnect();
        }

        screen.replaceChildren();
        connectionState = 'connecting';
        statusElement.textContent = <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.vnc.connecting', true)); ?>;
        updateControls();

        try {
            var connection = new RFB(
                screen,
                <?php echo json_encode($action_result['websocket_url']); ?>,
                {
                    credentials: {
                        password: <?php echo json_encode($action_result['password']); ?>
                    },
                    wsProtocols: ['binary', 'base64']
                }
            );
            rfb = connection;
            applyDisplayPreferences(connection);
            connection.addEventListener('connect', function () {
                if (rfb !== connection) {
                    return;
                }
                connectionState = 'connected';
                statusElement.textContent = <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.vnc.connected', true)); ?>;
                updateControls();
            });
            connection.addEventListener('disconnect', function (event) {
                if (rfb !== connection) {
                    return;
                }
                rfb = null;
                setDisconnectedStatus(event.detail.clean);
            });
            connection.addEventListener('clipboard', function (event) {
                if (!clipboardText) {
                    return;
                }
                clipboardText.value = event.detail.text || '';
                if (clipboardStatus) {
                    clipboardStatus.textContent = <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.vnc.clipboard_received', true)); ?>;
                }
            });
        } catch (error) {
            rfb = null;
            setDisconnectedStatus(false);
        }
    }

    function loadConsole() {
        import(noVncModuleUrl).then(function (module) {
            RFB = module.default;
            connect();
        }).catch(function () {
            setDisconnectedStatus(false);
        });
    }

    function showModal() {
        if (window.bootstrap
            && window.bootstrap.Modal
            && typeof window.bootstrap.Modal.getOrCreateInstance === 'function') {
            var modal = window.bootstrap.Modal.getOrCreateInstance(modalElement, {
                backdrop: true,
                keyboard: true
            });
            modalElement.addEventListener('shown.bs.modal', loadConsole, {once: true});
            modal.show();
            return;
        }

        if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
            window.jQuery(modalElement)
                .one('shown.bs.modal', loadConsole)
                .modal({
                    backdrop: true,
                    keyboard: true,
                    show: true
                });
            return;
        }

        modalElement.style.display = 'block';
        modalElement.classList.add('show');
        modalElement.removeAttribute('aria-hidden');
        modalElement.setAttribute('aria-modal', 'true');
        loadConsole();
    }

    function disableVnc() {
        if (disableRequested || !closeForm) {
            return;
        }
        disableRequested = true;
        if (rfb) {
            rfb.disconnect();
            rfb = null;
        }
        if (!window.fetch || !window.FormData) {
            closeForm.submit();
            return;
        }
        var disableData = new FormData(closeForm);
        disableData.set('vf_response', 'action');
        window.fetch(closeForm.getAttribute('action') || window.location.href, {
            method: 'POST',
            body: disableData,
            credentials: 'same-origin',
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        }).catch(function () {});
    }

    function hideModal() {
        if (window.bootstrap && window.bootstrap.Modal) {
            window.bootstrap.Modal.getOrCreateInstance(modalElement).hide();
            return;
        }
        if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
            window.jQuery(modalElement).modal('hide');
            return;
        }
        modalElement.style.display = 'none';
        modalElement.classList.remove('show');
        disableVnc();
    }

    if (reconnectButton) {
        reconnectButton.addEventListener('click', connect);
    }
    if (ctrlAltDel) {
        ctrlAltDel.addEventListener('click', function () {
            if (rfb && connectionState === 'connected' && !(viewOnlyToggle && viewOnlyToggle.checked)) {
                rfb.sendCtrlAltDel();
            }
        });
    }
    if (scaleToggle) {
        scaleToggle.addEventListener('change', function () {
            if (rfb) {
                applyDisplayPreferences(rfb);
            } else {
                screen.style.overflow = scaleToggle.checked ? 'hidden' : 'auto';
            }
        });
    }
    if (viewOnlyToggle) {
        viewOnlyToggle.addEventListener('change', function () {
            if (rfb) {
                rfb.viewOnly = viewOnlyToggle.checked;
            }
            updateControls();
        });
    }
    if (resizeToggle) {
        resizeToggle.addEventListener('change', function () {
            if (rfb) {
                rfb.resizeSession = resizeToggle.checked;
            }
        });
    }
    if (clipboardToggle && clipboardPanel) {
        clipboardToggle.addEventListener('click', function () {
            clipboardPanel.hidden = !clipboardPanel.hidden;
            clipboardToggle.setAttribute('aria-expanded', clipboardPanel.hidden ? 'false' : 'true');
        });
    }
    if (sendClipboard && clipboardText) {
        sendClipboard.addEventListener('click', function () {
            if (!rfb || connectionState !== 'connected' || (viewOnlyToggle && viewOnlyToggle.checked)) {
                return;
            }
            rfb.clipboardPasteFrom(clipboardText.value);
            if (clipboardStatus) {
                clipboardStatus.textContent = <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.vnc.clipboard_sent', true)); ?>;
            }
        });
    }
    if (copyClipboard && clipboardText) {
        copyClipboard.addEventListener('click', function () {
            var copied = function () {
                if (clipboardStatus) {
                    clipboardStatus.textContent = <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.vnc.clipboard_copied', true)); ?>;
                }
            };
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(clipboardText.value).then(copied);
                return;
            }
            clipboardText.select();
            document.execCommand('copy');
            copied();
        });
    }
    if (fullscreenButton) {
        if (!modalElement.requestFullscreen) {
            fullscreenButton.disabled = true;
        } else {
            fullscreenButton.addEventListener('click', function () {
                if (document.fullscreenElement === modalElement) {
                    document.exitFullscreen();
                } else {
                    modalElement.requestFullscreen();
                }
            });
            document.addEventListener('fullscreenchange', function () {
                fullscreenButton.textContent = document.fullscreenElement === modalElement
                    ? <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.vnc.exit_fullscreen', true)); ?>
                    : <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.vnc.fullscreen', true)); ?>;
            });
        }
    }
    if (closeButton) {
        closeButton.addEventListener('click', function (event) {
            event.preventDefault();
            hideModal();
        });
    }
    modalElement.addEventListener('hidden.bs.modal', disableVnc);
    if (window.jQuery) {
        window.jQuery(modalElement).one('hidden.bs.modal', disableVnc);
    }

    showModal();
}());
</script>
<?php } ?>
