<style>
.vf-password-control { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.5rem; align-items: end; }
.vf-password-control .btn { min-height: calc(1.5em + 0.75rem + 2px); white-space: nowrap; }
.vf-password-status-heading { display: flex; align-items: center; gap: 0.75rem; }
.vf-password-spinner { flex: 0 0 auto; width: 1.25rem; height: 1.25rem; border: 0.18rem solid #9ec5fe; border-top-color: #0d6efd; border-radius: 50%; animation: vf-password-spin 0.8s linear infinite; }
.vf-password-progress { height: 0.4rem; overflow: hidden; background: #d9e2ec; border-radius: 0.25rem; }
.vf-password-progress-bar { width: 38%; height: 100%; background: #0d6efd; animation: vf-password-scroll 1.15s ease-in-out infinite; }
.vf-password-dots span { animation: vf-password-dot 1.4s infinite both; }
.vf-password-dots span:nth-child(2) { animation-delay: 0.2s; }
.vf-password-dots span:nth-child(3) { animation-delay: 0.4s; }
@keyframes vf-password-spin { to { transform: rotate(360deg); } }
@keyframes vf-password-scroll { from { transform: translateX(-110%); } to { transform: translateX(370%); } }
@keyframes vf-password-dot { 0%, 20% { opacity: 0.2; } 45%, 100% { opacity: 1; } }
@media (max-width: 575.98px) {
    .vf-password-control { grid-template-columns: minmax(0, 1fr); }
    .vf-password-control .btn { width: 100%; }
}
</style>
<script type="text/javascript">
(function () {
    if (window.virtfusionResultModal) {
        return;
    }

    window.virtfusionResultModal = {
        show: function (modal) {
            if (!modal) {
                return;
            }
            if (modal.hasAttribute('data-vf-manage-overlay')) {
                modal.hidden = false;
                modal.classList.add('show');
                return;
            }
            if (window.bootstrap && window.bootstrap.Modal
                && typeof window.bootstrap.Modal.getOrCreateInstance === 'function') {
                window.bootstrap.Modal.getOrCreateInstance(modal, {backdrop: true, keyboard: true}).show();
                return;
            }
            if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
                window.jQuery(modal).modal({backdrop: true, keyboard: true, show: true});
                return;
            }
            var backdrop = document.createElement('div');
            backdrop.className = 'modal-backdrop fade show';
            backdrop.setAttribute('data-vf-result-backdrop', 'true');
            document.body.appendChild(backdrop);
            document.body.classList.add('modal-open');
            modal.style.display = 'block';
            modal.classList.add('show');
            modal.removeAttribute('aria-hidden');
            modal.setAttribute('aria-modal', 'true');
        },
        remove: function (modal) {
            if (!modal) {
                return;
            }
            if (modal.hasAttribute('data-vf-manage-overlay')) {
                var root = modal.closest('#tabManage, #tabAdminManage');
                modal.remove();
                var taskStatus = root && root.querySelector('[data-vf-task-status]');
                if (taskStatus) {
                    taskStatus.hidden = root.getAttribute('data-vf-busy') !== 'true'
                        || !!root.querySelector('[data-vf-action-overlay]');
                }
                return;
            }
            var removeElement = function () {
                modal.remove();
            };
            if (window.bootstrap && window.bootstrap.Modal
                && typeof window.bootstrap.Modal.getInstance === 'function') {
                var instance = window.bootstrap.Modal.getInstance(modal);
                if (instance) {
                    modal.addEventListener('hidden.bs.modal', removeElement, {once: true});
                    instance.hide();
                    return;
                }
            }
            if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
                window.jQuery(modal).one('hidden.bs.modal', removeElement).modal('hide');
                return;
            }
            modal.remove();
            document.querySelectorAll('[data-vf-result-backdrop]').forEach(function (backdrop) {
                backdrop.remove();
            });
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('padding-right');
        }
    };
}());
</script>
