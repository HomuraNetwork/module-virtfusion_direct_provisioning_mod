<?php if (($action_result['type'] ?? null) === 'password') { ?>
<div class="alert alert-success border-success mb-3" role="alert">
    <h5 class="alert-heading mb-2"><?php $this->_('VirtfusionDirectProvisioningMod.password_result.heading'); ?></h5>
    <p class="mb-3"><?php $this->_('VirtfusionDirectProvisioningMod.password_result.notice'); ?></p>
    <div class="input-group">
        <input
            type="text"
            class="form-control font-monospace fw-semibold"
            id="virtfusionNewPassword"
            value="<?php echo $this->Html->safe($action_result['password']); ?>"
            readonly
            autocomplete="off"
        >
        <button type="button" class="btn btn-success" id="virtfusionCopyPassword">
            <?php $this->_('VirtfusionDirectProvisioningMod.password_result.copy'); ?>
        </button>
    </div>
</div>
<script type="text/javascript">
(function () {
    var button = document.getElementById('virtfusionCopyPassword');
    var field = document.getElementById('virtfusionNewPassword');
    if (!button || !field) {
        return;
    }

    button.addEventListener('click', function () {
        var copied = function () {
            button.textContent = <?php echo json_encode(Language::_('VirtfusionDirectProvisioningMod.password_result.copied', true)); ?>;
        };

        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(field.value).then(copied);
            return;
        }

        field.select();
        document.execCommand('copy');
        copied();
    });
}());
</script>
<?php } ?>

<?php if (($action_result['type'] ?? null) === 'vnc') { ?>
<style>
