<?php
$vf_empty = $empty_value ?? '—';
$vf_memory = $vf_empty;
if (isset($server_info->memory) && is_numeric($server_info->memory)) {
    $vf_memory_gb = (float) $server_info->memory / 1024;
    $vf_memory = rtrim(rtrim(number_format($vf_memory_gb, 2, '.', ''), '0'), '.') . ' GB';
}
$vf_traffic_used = $server_info->traffic_used_display
    ?? (isset($server_info->traffic_used) ? $server_info->traffic_used . ' GB' : $vf_empty);
$vf_resources = [
    'cpu' => [
        'icon' => 'fa-microchip',
        'value' => isset($server_info->cpu) ? $server_info->cpu . ' vCPU' : $vf_empty
    ],
    'memory' => [
        'icon' => 'fa-memory',
        'value' => $vf_memory
    ],
    'disk' => [
        'icon' => 'fa-hdd',
        'value' => isset($server_info->disk) ? $server_info->disk . ' GB' : $vf_empty
    ]
];
?>
<style>
.vf-server-overview { border: 1px solid #dee2e6; border-radius: 0.25rem; overflow: hidden; background: #fff; }
.vf-server-overview-header { padding: 1rem 1.25rem; border-bottom: 1px solid #dee2e6; }
.vf-server-overview-state { display: flex; align-items: center; gap: 0.5rem; }
.vf-server-overview-section { padding: 1.25rem; }
.vf-server-overview-section + .vf-server-overview-section { border-top: 1px solid #dee2e6; }
.vf-server-stat { min-width: 0; min-height: 5.25rem; padding: 0.75rem; background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 0.25rem; }
.vf-server-resource-stat { min-height: 7rem; }
.vf-server-resource-stat.vf-server-stat-warning { border-color: #dc3545; background: #fff8f8; }
.vf-server-stat-heading { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.45rem; }
.vf-server-stat-icon { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 1.6rem; height: 1.6rem; color: #495057; background: #e9ecef; border-radius: 50%; }
.vf-server-stat-value { overflow-wrap: anywhere; font-size: 1.1rem; font-weight: 600; }
.vf-server-meter-slot { min-height: 2.05rem; margin-top: 0.6rem; }
.vf-server-meter-label { display: flex; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.25rem; font-size: 0.75rem; }
.vf-server-meter-slot .progress { height: 0.4rem; }
.vf-server-meter-memory .progress-bar { background-color: #198754; }
.vf-server-meter-disk .progress-bar { background-color: #6c757d; }
.vf-server-disk-warning { margin-top: 0.65rem; padding-top: 0.65rem; border-top: 1px solid #f1aeb5; color: #842029; font-size: 0.8rem; }
.vf-server-detail-row { display: flex; justify-content: space-between; gap: 1rem; padding-top: 0.75rem; }
.vf-server-detail-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 1.5rem; }
.vf-traffic-totals { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 1rem; border: 1px solid #e9ecef; border-radius: 0.25rem; background: #f8f9fa; }
.vf-traffic-total { min-width: 0; padding: 0.85rem 1rem; }
.vf-traffic-total + .vf-traffic-total { border-left: 1px solid #e9ecef; }
.vf-traffic-total strong { display: block; margin-top: 0.2rem; overflow-wrap: anywhere; font-size: 1.05rem; }
@media (max-width: 575.98px) {
    .vf-server-detail-grid { grid-template-columns: 1fr; }
    .vf-traffic-totals { grid-template-columns: 1fr; }
    .vf-traffic-total + .vf-traffic-total { border-top: 1px solid #e9ecef; border-left: 0; }
}
</style>
<div class="vf-server-overview mb-4">
    <div class="vf-server-overview-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="h5 mb-1" data-vf-state-name><?php echo $this->Html->safe($server_info->name ?? $vf_empty); ?></div>
            <div class="small text-muted"><?php echo $this->Html->safe($package->name ?? $vf_empty); ?></div>
        </div>
        <div class="vf-server-overview-state">
            <span class="badge <?php echo $running === true ? 'bg-success badge-success' : 'bg-secondary badge-secondary'; ?>" data-vf-state-status>
                <?php echo $this->Html->safe($server_info->status ?? $vf_empty); ?>
            </span>
            <?php $this->Form->create($_SERVER['REQUEST_URI']); ?>
                <button type="submit" name="action" value="<?php echo !empty($is_admin) ? 'refresh_ips' : 'refresh_state'; ?>" class="btn btn-sm btn-outline-secondary" data-vf-state-refresh title="<?php $this->_('VirtfusionDirectProvisioningMod.tabManage.refresh_state'); ?>" aria-label="<?php $this->_('VirtfusionDirectProvisioningMod.tabManage.refresh_state'); ?>" <?php echo $server_busy ? 'disabled' : ''; ?>><i class="fas fa-sync-alt" aria-hidden="true"></i></button>
            <?php $this->Form->end(); ?>
        </div>
    </div>

    <?php include __DIR__ . '/server_actions.pdt'; ?>

    <section class="vf-server-overview-section">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <strong><?php $this->_('VirtfusionDirectProvisioningMod.service_info.resources_current'); ?></strong>
            <span class="small text-muted">VirtFusion</span>
        </div>
        <div class="row g-2">
            <?php foreach ($vf_resources as $vf_resource_key => $vf_resource) { ?>
            <?php $vf_disk_warning = $vf_resource_key === 'disk' && !empty($storage_mismatch); ?>
            <div class="col-12 col-sm-4">
                <div class="vf-server-stat vf-server-resource-stat h-100 <?php echo $vf_disk_warning ? 'vf-server-stat-warning' : ''; ?>">
                    <div class="vf-server-stat-heading">
                        <span class="vf-server-stat-icon" aria-hidden="true"><i class="fas <?php echo $vf_resource['icon']; ?>"></i></span>
                        <span class="small text-muted"><?php $this->_('VirtfusionDirectProvisioningMod.service_info.' . $vf_resource_key); ?></span>
                    </div>
                    <div class="vf-server-stat-value" data-vf-resource-value="<?php echo $vf_resource_key; ?>"><?php echo $this->Html->safe($vf_resource['value']); ?></div>
                    <?php $vf_usage = $server_info->resource_usage->{$vf_resource_key} ?? null; ?>
                    <div class="vf-server-meter-slot vf-server-meter-<?php echo $vf_resource_key; ?>" data-resource-meter="<?php echo $vf_resource_key; ?>">
                            <div class="vf-server-meter-label text-muted" data-vf-resource-usage-row <?php echo is_numeric($vf_usage) ? '' : 'hidden'; ?>>
                                <span><?php $this->_('VirtfusionDirectProvisioningMod.service_info.usage'); ?></span>
                                <strong data-vf-resource-usage><?php echo is_numeric($vf_usage) ? $this->Html->safe($vf_usage) . '%' : ''; ?></strong>
                            </div>
                            <div class="progress" data-vf-resource-progress role="progressbar" aria-label="<?php $this->_('VirtfusionDirectProvisioningMod.service_info.' . $vf_resource_key); ?>" aria-valuenow="<?php echo is_numeric($vf_usage) ? (float) $vf_usage : 0; ?>" aria-valuemin="0" aria-valuemax="100" <?php echo is_numeric($vf_usage) ? '' : 'hidden'; ?>>
                                <div class="progress-bar" data-vf-resource-progress-bar style="width: <?php echo is_numeric($vf_usage) ? (float) $vf_usage : 0; ?>%"></div>
                            </div>
                    </div>
                    <?php if ($vf_disk_warning) { ?>
                        <div class="vf-server-disk-warning">
                            <?php echo $this->Html->safe(Language::_(
                                'VirtfusionDirectProvisioningMod.storage.disk_mismatch',
                                true,
                                $storage_mismatch->expected,
                                $storage_mismatch->actual
                            )); ?>
                            <?php if (!empty($support_ticket_url)) { ?>
                                <a href="<?php echo $this->Html->safe($support_ticket_url); ?>" class="btn btn-danger btn-sm mt-2">
                                    <?php $this->_('VirtfusionDirectProvisioningMod.storage.open_ticket'); ?>
                                </a>
                            <?php } ?>
                        </div>
                    <?php } ?>
                </div>
            </div>
            <?php } ?>
        </div>
    </section>

    <section class="vf-server-overview-section">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong><?php $this->_('VirtfusionDirectProvisioningMod.service_info.traffic_bandwidth'); ?></strong>
            <span class="small text-muted">
                <span data-vf-traffic="used"><?php echo $this->Html->safe($vf_traffic_used); ?></span> /
                <span data-vf-traffic="limit"><?php echo isset($server_info->traffic_total)
                    ? $this->Html->safe($server_info->traffic_total) . ' GB'
                    : $vf_empty; ?></span>
            </span>
        </div>
            <div class="progress mb-3" data-vf-traffic-progress style="height: 0.5rem;" <?php echo isset($server_info->traffic_percent) ? '' : 'hidden'; ?>>
                <div class="progress-bar" data-vf-traffic-progress-bar role="progressbar" style="width: <?php echo isset($server_info->traffic_percent) ? (float) $server_info->traffic_percent : 0; ?>%" aria-valuenow="<?php echo isset($server_info->traffic_percent) ? (float) $server_info->traffic_percent : 0; ?>" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        <div class="vf-traffic-totals">
            <?php foreach ([
                'traffic_in' => $server_info->traffic_in_display ?? $vf_empty,
                'traffic_out' => $server_info->traffic_out_display ?? $vf_empty,
                'traffic_sum' => $vf_traffic_used
            ] as $vf_traffic_key => $vf_traffic_value) { ?>
            <div class="vf-traffic-total">
                <span class="small text-muted"><?php $this->_('VirtfusionDirectProvisioningMod.service_info.' . $vf_traffic_key); ?></span>
                <strong data-vf-traffic="<?php echo str_replace('traffic_', '', $vf_traffic_key); ?>"><?php echo $this->Html->safe($vf_traffic_value); ?></strong>
            </div>
            <?php } ?>
        </div>
        <div class="vf-server-detail-grid">
            <div class="vf-server-detail-row">
                <span class="text-muted"><?php $this->_('VirtfusionDirectProvisioningMod.service_info.traffic_server'); ?></span>
                <strong data-vf-traffic="server"><?php echo isset($server_info->traffic_server)
                    ? $this->Html->safe($server_info->traffic_server) . ' GB'
                    : $vf_empty; ?></strong>
            </div>
            <div class="vf-server-detail-row">
                <span class="text-muted"><?php $this->_('VirtfusionDirectProvisioningMod.service_info.traffic_blocks'); ?></span>
                <strong data-vf-traffic="blocks"><?php echo $this->Html->safe($server_info->traffic_blocks ?? 0); ?> GB</strong>
            </div>
            <div class="vf-server-detail-row">
                <span class="text-muted"><?php $this->_('VirtfusionDirectProvisioningMod.service_info.traffic_resets'); ?></span>
                <strong data-vf-traffic="reset"><?php echo !empty($server_info->traffic_reset)
                    ? $this->Html->safe($this->Date->cast($server_info->traffic_reset, 'M j, Y'))
                    : $vf_empty; ?></strong>
            </div>
        </div>
    </section>
</div>
