<?php
$primary_ipv4 = $ip_data->ip_addresses['main'][0] ?? null;
$ipv6 = $ip_data->ip_addresses['ipv6'][0] ?? null;
?>
<?php if ($primary_ipv4 || $ipv6) { ?>
<div class="card border-0 bg-light mb-3">
    <div class="card-body py-3">
        <div class="row g-3">
            <?php if ($primary_ipv4) { ?>
            <div class="col-md-6">
                <div class="text-muted small mb-1"><?php $this->_('VirtfusionDirectProvisioningMod.service_info.main_ip'); ?></div>
                <code><?php echo $this->Html->safe($primary_ipv4); ?></code>
            </div>
            <?php } ?>
            <?php if ($ipv6) { ?>
            <div class="col-md-6">
                <div class="text-muted small mb-1"><?php $this->_('VirtfusionDirectProvisioningMod.ipAddresses.ipv6'); ?></div>
                <code><?php echo $this->Html->safe($ipv6); ?></code>
            </div>
            <?php } ?>
        </div>
    </div>
</div>
<?php } ?>
