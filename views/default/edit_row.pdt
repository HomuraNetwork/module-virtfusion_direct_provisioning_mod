<?php /** @var View $this **/ ?>

<?php
$this->Widget->clear();

$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Virtfusion.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . $module->id],
    ],
]);

$this->Form->create(null, ['class' => 'disable-on-submit']);
$this->Widget->create($this->_('VirtfusionDirectProvisioningMod.edit_row.box_title', true));
?>

<div class="mb-3">
    <label for="name" class="form-label">
        <?php $this->_('VirtfusionDirectProvisioningMod.row_meta.name'); ?>
    </label>
    <?php $this->Form->fieldText('name', $vars->name ?? null, ['id' => 'name', 'class' => 'form-control']); ?>
</div>

<div class="mb-3 form-check">
    <?php $this->Form->fieldCheckbox(
        'allow_insecure_tls',
        'true',
        ($vars->allow_insecure_tls ?? 'false') === 'true',
        ['id' => 'allow_insecure_tls', 'class' => 'form-check-input']
    ); ?>
    <label for="allow_insecure_tls" class="form-check-label">
        <?php $this->_('VirtfusionDirectProvisioningMod.row_meta.allow_insecure_tls'); ?>
    </label>
    <div class="form-text text-danger">
        <?php $this->_('VirtfusionDirectProvisioningMod.row_meta.allow_insecure_tls.help_text'); ?>
    </div>
</div>

<div class="mb-3">
    <label for="hostname" class="form-label">
        <?php $this->_('VirtfusionDirectProvisioningMod.row_meta.hostname'); ?>
    </label>
    <?php $this->Form->fieldText('hostname', $vars->hostname ?? null, [
        'id' => 'hostname',
        'class' => 'form-control',
    ]); ?>
</div>

<div class="mb-3">
    <label for="api_token" class="form-label">
        <?php $this->_('VirtfusionDirectProvisioningMod.row_meta.api_token'); ?>
    </label>
    <?php $this->Form->fieldTextarea('api_token', $vars->api_token ?? null, [
        'id' => 'api_token',
        'class' => 'form-control',
    ]); ?>
</div>

<div class="mb-3">
    <label for="admin_server_url" class="form-label">
        <?php $this->_('VirtfusionDirectProvisioningMod.row_meta.admin_server_url'); ?>
    </label>
    <?php $this->Form->fieldText(
        'admin_server_url',
        $vars->admin_server_url ?? 'https://{hostname}/admin/servers/{server_id}',
        ['id' => 'admin_server_url', 'class' => 'form-control']
    ); ?>
    <div class="form-text">
        <?php $this->_('VirtfusionDirectProvisioningMod.row_meta.admin_server_url.help_text'); ?>
    </div>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('VirtfusionDirectProvisioningMod.edit_row.edit_btn', true), [
        'class' => 'btn btn-primary',
    ]); ?>
</div>

<?php
$this->Widget->end();
$this->Form->end();


